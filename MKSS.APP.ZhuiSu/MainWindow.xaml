<Window
    x:Class="DeviceDataMonitorWPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeviceDataMonitorWPF.UserCommon"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:UIZhuiSu="clr-namespace:MKSS.APP.ZhuiSu"
    Title="郑州美克盛世电子科技有限公司"
    Width="800"
    Height="450" 
    Background="{DynamicResource  PrimaryHueLightBrush}"
    TextElement.FontSize="14"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized" 
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">
    <Viewbox Stretch="Fill">
        <Grid Width="1920" Height="1080" Background="{DynamicResource  PrimaryHueLightBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="674" />
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="119" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <materialDesign:DrawerHost
                x:Name="dhDrawerHost"
                Grid.Row="1" 
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0"
                OpenMode="Standard" Grid.ColumnSpan="2">
                <UIZhuiSu:UIZhuiSu/>
                
            </materialDesign:DrawerHost>


            <materialDesign:ColorZone
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Padding="8" 
                VerticalAlignment="Center"
                Mode="PrimaryDark">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image
                        Width="368"
                        Height="120"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="/Resources/Images/logo5.png" />
                        <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="43"
                        FontWeight="Bold"
                        Text="智慧工厂生产数字化管理系统-半导体传感器特性数据追溯软件" />
                        <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="v2.3A" />
                    </StackPanel>

                    <Button Width="30" Visibility="Hidden" />
                </DockPanel>
            </materialDesign:ColorZone>


        </Grid>
    </Viewbox>
</Window>
