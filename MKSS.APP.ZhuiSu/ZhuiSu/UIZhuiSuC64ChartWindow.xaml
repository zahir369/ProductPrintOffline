<Window x:Class="MKSS.APP.ZhuiSu.UIZhuiSuC64ChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MKSS.APP.ZhuiSu"
        xmlns:ScottPlot="clr-namespace:ScottPlot;assembly=ScottPlot.WPF"
        mc:Ignorable="d" ShowInTaskbar="False"
        Title="元器件特性曲线"  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:DeviceDataMonitorWPF="clr-namespace:DeviceDataMonitorWPF" 
              Foreground="Black"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"  
             xmlns:s="https://github.com/canton7/Stylet" WindowStartupLocation="CenterScreen" 
             d:DesignHeight="400" d:DesignWidth="1600" Height="400" Width="1600">

     
    <Border  
            Grid.Row="0" BorderThickness="1" BorderBrush="LightGray"  
            materialDesign:ShadowAssist.ShadowDepth="Depth4" >
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160*"/>
                <ColumnDefinition Width="160*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="20*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="20*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="100*"/>
            </Grid.RowDefinitions>
            <!--<ScottPlot:WpfPlot Name="wpfPlotTemperature" Cursor="Cross" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" Grid.RowSpan="4" />
            <ScottPlot:WpfPlot Name="wpfPlotHumidity" Cursor="Cross" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" Grid.RowSpan="4" />-->
            <ScottPlot:WpfPlot Name="wpfPlot1" Cursor="Cross" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" Grid.RowSpan="4" 
                               MouseMove="OnMouseMove" Background="Transparent" />

            <!--<CheckBox x:Name="LockX"  IsChecked="True" Visibility="Hidden" Margin="5 0 5 0"   Checked="LockX_Checked" Unchecked="LockX_Checked" Content="缩放电压" />
            <CheckBox x:Name="LockY" IsChecked="True"  Visibility="Hidden" Margin="5 0 35 0" Checked="LockX_Checked" Unchecked="LockX_Checked" Content="缩放时间" />-->

            <Label Content="时间" Grid.Row="1" Grid.Column="2" FontWeight="Bold"/>
            <Label Content="电压" Foreground="Blue" Grid.Row="2" Grid.Column="2" FontWeight="Bold"/>

            <Label Name="XCoordinateLabel" Content="0.0" Grid.Row="1" Grid.Column="3" FontFamily="consolas" />
            <Label Name="YCoordinateLabel" Content="0.0" Grid.Row="2" Grid.Column="3" FontFamily="consolas" />

            <Label Content="温度" Foreground="Red" Grid.Row="1" Grid.Column="4" FontWeight="Bold"/>
            <Label Content="湿度" Grid.Row="2" Foreground="Green" Grid.Column="4" FontWeight="Bold"/>

            <Label Name="XPixelLabel" Content="--℃" Grid.Row="1" Grid.Column="5" FontFamily="consolas" />
            <Label Name="YPixelLabel" Content="--%" Grid.Row="2" Grid.Column="5" FontFamily="consolas" />

        </Grid>
    </Border>
</Window>
