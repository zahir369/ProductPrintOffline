<UserControl x:Class="MKSS.APP.ZhuiSu.UIZhuiSuC64Setting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:MKSS.APP.ZhuiSu"
             mc:Ignorable="d" Background="White" 
             d:DesignHeight="60" d:DesignWidth="1800">
    <Grid Margin="10,10,10,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="当前批次" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="15"  FontWeight="Bold"  Foreground="#FF000F59" />
        <ComboBox Grid.Row="0" Grid.Column="1" 
                    x:Name="TxtBatchList"  Margin="0,15,20,0" SelectionChanged="TxtBatchList_SelectionChanged" 
                    Text="{Binding TxtBatchList, UpdateSourceTrigger=PropertyChanged}" 
                    DisplayMemberPath="F_BatchName" SelectedValuePath="F_BatchId" 
                    IsEnabled="{Binding Path=IsChecked }" >
            <ComboBoxItem Content="COM1" />
            <ComboBoxItem Content="Item 2" />
            <ComboBoxItem Content="Item 3" />
        </ComboBox>

        <TextBox Grid.Row="0" Grid.Column="2" 
                    x:Name="TxtTestTimePoints"  Margin="0,0,5,0" 
                    Text="4,30,50,70,80,150,180,250,280,300" IsEnabled="False"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="">
            <materialDesign:HintAssist.Hint>
                <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                    <TextBlock Foreground="#FF188C8E" FontSize="14" FontWeight="Bold" Text="时间点，最多10个" />
                </StackPanel>
            </materialDesign:HintAssist.Hint>
        </TextBox>

        <Button Grid.Row="0" Grid.Column="3"
                    x:Name="BtnAddBatch" Click="BtnAddBatch_Click"  Background="Green"
                    materialDesign:ButtonAssist.CornerRadius="23"   FontSize="15" FontWeight="Bold" 
                    Height="36" Width="110"   
                    ToolTip="" Cursor="Hand">
            <TextBlock Text="新建/开始" />
        </Button>
 

        <Button Grid.Row="0" Grid.Column="4"
                    x:Name="BtnRegisterSensors" Click="BtnRegisterSensors_Click" 
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="23"   FontSize="15" FontWeight="Bold" 
                    Height="36" Width="110" Background="#4169E1	"    
                    ToolTip="" Cursor="Hand">
            <TextBlock Text="扫码登记" />
        </Button>

        <Button Grid.Row="0" Grid.Column="6"
                    x:Name="BtnExcelExport" Click="BtnExcelExport_Click" 
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="23"   FontSize="15" FontWeight="Bold" 
                    Height="36" Width="110"   
                    ToolTip="" Cursor="Hand">
            <TextBlock Text="导出结果" />
        </Button>
 

        <Button Grid.Row="0" Grid.Column="5"
                    x:Name="BtnFinishBoard" Click="BtnFinishBoard_Click" 
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="23"   FontSize="15" FontWeight="Bold" 
                    Height="36" Width="110" Background="#FFD33F34"  
                    ToolTip="" Cursor="Hand">
            <TextBlock Text="停止" />
        </Button>

    </Grid>
</UserControl>
