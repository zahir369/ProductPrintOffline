<UserControl x:Class="MKSS.APP.ZhuiSu.UIZhuiSuC10Chart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MKSS.APP.ZhuiSu"
             xmlns:ScottPlot="clr-namespace:ScottPlot;assembly=ScottPlot.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160*"/>
            <ColumnDefinition Width="160*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="20*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>
        <ScottPlot:WpfPlot Name="wpfPlot1" Cursor="Help" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Grid.RowSpan="4" MouseMove="OnMouseMove"/>

        <Label Content="X" Grid.Row="1" Grid.Column="2" FontWeight="Bold"/>
        <Label Content="Y" Grid.Row="2" Grid.Column="2" FontWeight="Bold"/>

        <Label Content="Pixel" Grid.Row="0" Grid.Column="3" FontWeight="Bold"/>
        <Label Content="Coordinate" Grid.Row="0" Grid.Column="4" FontWeight="Bold"/>

        <Label Name="XPixelLabel" Content="123.456" Grid.Row="1" Grid.Column="3" FontFamily="consolas" />
        <Label Name="YPixelLabel" Content="123.456" Grid.Row="2" Grid.Column="3" FontFamily="consolas" />

        <Label Name="XCoordinateLabel" Content="123.456" Grid.Row="1" Grid.Column="4" FontFamily="consolas" />
        <Label Name="YCoordinateLabel" Content="123.456" Grid.Row="2" Grid.Column="4" FontFamily="consolas" />

    </Grid>
</UserControl>
