<Window x:Class="MKSS.APP.ZhuiSu.UIZhuiSuAddCondition"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" ShowInTaskbar="False"
        Title="添加元器件环境条件"  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
              Foreground="Black"
             xmlns:s="https://github.com/canton7/Stylet" WindowStartupLocation="CenterScreen" 
             d:DesignHeight="400" d:DesignWidth="600" Height="400" Width="600">
 
    <Border  
            Grid.Row="0" BorderThickness="1" BorderBrush="LightGray"  
            materialDesign:ShadowAssist.ShadowDepth="Depth4" >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="150*"/>
                <RowDefinition Height="50*"/>
            </Grid.RowDefinitions>

              

            <TextBox  Grid.Row="0" Grid.Column="0"  FontSize="23"
                    x:Name="F_Temperature"  Margin="10,0,10,5"  PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding F_Temperature, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText=" ℃">
                <materialDesign:HintAssist.Hint>
                    <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                        <TextBlock Text="温度" FontSize="14" FontWeight="Bold" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>

            <TextBox  Grid.Row="0" Grid.Column="1"  FontSize="23"
                    x:Name="F_Humidity"  Margin="10,0,10,5"  PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding F_Humidity, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="%">
                <materialDesign:HintAssist.Hint>
                    <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                        <TextBlock Text="湿度" FontSize="14" FontWeight="Bold" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>


            <TextBox  Grid.Row="1" Grid.Column="0"  FontSize="23"
                    x:Name="F_PAR1"  Margin="10,0,10,5"  PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding F_PAR1, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="">
                <materialDesign:HintAssist.Hint>
                    <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                        <TextBlock Text="预留1" FontSize="14" FontWeight="Bold" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>

            <TextBox  Grid.Row="1" Grid.Column="1"  FontSize="23"
                    x:Name="F_PAR2"  Margin="10,0,10,5"  PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding F_PAR2, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="">
                <materialDesign:HintAssist.Hint>
                    <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                        <TextBlock Text="预留2" FontSize="14" FontWeight="Bold" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox> 
            <TextBox x:Name="F_Memo" Grid.Row="2" Grid.Column="0" 
                    Grid.ColumnSpan="2"  Margin="10,10,10,5"
                  TextWrapping="Wrap"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                  VerticalAlignment="Stretch"
                  MinWidth="280"
                  AcceptsReturn="True"
                  VerticalScrollBarVisibility="Auto"
                  SpellCheck.IsEnabled="True" 
                  Text=" " >
                <materialDesign:HintAssist.Hint>
                    <StackPanel Orientation="Horizontal" Width="68" Height="31">
                        <TextBlock Text="备注" FontSize="14" FontWeight="Bold" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>

            <Button Grid.Row="3" Grid.Column="0"  Click="BtnDelete_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" 
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnDelete" Content="删除" Width="120" Background="red" Visibility="Hidden"  Margin="10,5,10,5" Cursor="Hand"/>

            <Button Grid.Row="3" Grid.Column="1"  Click="BtnAdd_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" 
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnAdd" Content="确定" Width="120" Background="#FF188C8E"  Margin="10,5,10,5" Cursor="Hand"/>

        </Grid>
    </Border>
</Window>
