<UserControl x:Class="MKSS.APP.ZhuiSu.UIZhuiSuC64"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MKSS.APP.ZhuiSu"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="800" d:DesignWidth="1800">

    <UserControl.DataContext>
        <local:UIZhuiSuC64Model/>
    </UserControl.DataContext>
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="43"/>
        </Grid.RowDefinitions>
        <local:UIZhuiSuC64Setting x:Name="UIZhuiSuC64Setting1" Grid.Column="0" Grid.Row="0" />

        <local:UIZhuiSuC64Grid x:Name="UIZhuiSuC64Grid" Grid.Row="1" Margin="0,0,0,0" BorderThickness="9,1,9,9" BorderBrush="{DynamicResource UIZhuiSuBrush}"/>

        <ListBox Grid.Row="2"
              Style="{StaticResource MaterialDesignChoiceChipListBox}"
              x:Name="gridPager" SelectionChanged="gridPager_SelectionChanged">
            <ListBoxItem Content="1-2" IsSelected="True"/>
            <ListBoxItem Content="3-4" />
            <ListBoxItem Content="5-6" />
        </ListBox>
        <Label x:Name="TimeNow" Grid.Row="2" Content="2021-02-02 12:00:00" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="15"  FontWeight="Bold"  Foreground="#FF000F59" />

        <ProgressBar Grid.Column="0" Grid.Row="1" Width="50" Height="50" Visibility="Hidden" x:Name="ProgressNow"
                Style="{StaticResource MaterialDesignCircularProgressBar}"
                Value="90" IsIndeterminate="True" />
    </Grid>
</UserControl>
