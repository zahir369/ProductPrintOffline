<Window x:Class="WpfChartTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfChartTest"
        mc:Ignorable="d" Background="{DynamicResource MaterialDesignPaper}" Foreground="LightGray"
             xmlns:d3="clr-namespace:InteractiveDataDisplay.WPF;assembly=InteractiveDataDisplay.WPF"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
         
    </Window.Resources>
    <Grid  >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions> 
        <d3:Chart Grid.Column="0" Grid.Row="0" 
            Name="plotter1" Background="{DynamicResource MaterialDesignPaper}" Foreground="LightGray"
                  IsXAxisReversed="False" PlotHeight="650" PlotWidth="150" PlotOriginX="-10" PlotOriginY="-20"
                   LegendVisibility="Hidden"
                  IsHorizontalNavigationEnabled="True" IsVerticalNavigationEnabled="True" >
            <d3:Chart.Title>
                <TextBlock HorizontalAlignment="Center" FontSize="18" Margin="0,5,0,5"></TextBlock>
            </d3:Chart.Title>
            <Grid Name="lines1"/>
        </d3:Chart>
         

    </Grid>
</Window>
