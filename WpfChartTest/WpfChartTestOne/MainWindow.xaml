<Window x:Class="WpfChartTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfChartTest"
        mc:Ignorable="d" Background="{DynamicResource MaterialDesignPaper}" Foreground="LightGray" 
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <local:VisibilityToCheckedConverter x:Key="VisibilityToCheckedConverter"/>
        
    </Window.Resources>
    <Grid  x:Name="linechartGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>
        <local:DrawingLine  x:Name="linechart"  Grid.Column="0" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <local:DrawingCanvas  x:Name="linechartInner"  Grid.Column="0" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            </local:DrawingCanvas>
        </local:DrawingLine>
        

        <StackPanel  x:Name="PAnelControl" Grid.Column="0" Grid.Row="0" Orientation="Horizontal"  Margin="35 10 0 0" Height="50"  HorizontalAlignment="Left" VerticalAlignment="Top" >
            <Button Width="120" Content="测试数据"  ></Button>
        </StackPanel>

    </Grid>
</Window>
