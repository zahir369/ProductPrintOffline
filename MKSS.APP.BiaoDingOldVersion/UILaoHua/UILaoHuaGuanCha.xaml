<UserControl x:Class="DeviceDataMonitorWPF.UILaoHua.UILaoHuaGuanCha"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeviceDataMonitorWPF.UILaoHua"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:DeviceDataMonitorWPF="clr-namespace:DeviceDataMonitorWPF" 
             mc:Ignorable="d" Foreground="Black"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:s="https://github.com/canton7/Stylet" Unloaded="UserControl_Unloaded" 
             d:DesignHeight="1000" d:DesignWidth="1800">
    <UserControl.DataContext>
        <local:UILaoHuaGuanChaModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <SolidColorBrush x:Key="MTextcolorBrush" Color="#FF233177" />
        <Style x:Key="MaterialDesignFloatingHintTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
            <Setter Property="Foreground" Value="#FF233177"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>
    <Grid  >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="43"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Grid.RowSpan="3"  
          Style="{StaticResource MaterialDesignNavigatilRailTabControl}" >
             
            <TabItem
                Header="{materialDesign:PackIcon Kind=TimelineClockOutline, Size=39}"
                Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="100*"/>
                        <RowDefinition Height="39"/>
                    </Grid.RowDefinitions>
                    <local:UILaoHuaGuanChaC10 x:Name="UILaoHuaGuanChaC10" Grid.Row="1" Margin="10,10,10,10"/>

                </Grid>
            </TabItem>
             
            <TabItem
                Header="{materialDesign:PackIcon Kind=ChartBarStacked, Size=39}"
                Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="100*"/>
                        <RowDefinition Height="39"/>
                    </Grid.RowDefinitions>
                    <local:UILaoHuaGuanChaCGK x:Name="UILaoHuaGuanChaCGK" Grid.Row="1" Margin="10,10,10,10"/>

                </Grid>
            </TabItem>
        </TabControl>

        <Border  
            Grid.Row="0" BorderThickness="1" BorderBrush="LightGray"  
            materialDesign:ShadowAssist.ShadowDepth="Depth4"
                Margin="83,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90*"/>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="80*"/>
                    <ColumnDefinition Width="90*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*"/>
                    <RowDefinition Height="100*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2">
                    <Grid.ColumnDefinitions> 
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100*"/>
                        <RowDefinition Height="100*"/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" Grid.Column="0"  Margin="10,5,0,5" x:Name="TxtPortsModeSelect"
                        Style="{StaticResource MaterialDesignChoiceChipListBox}"
                        SelectionChanged="TxtPortsModeSelect_SelectionChanged" >
                        <ListBoxItem IsSelected="True" Content="机柜" />
                        <ListBoxItem Content="局域网" />
                        <ListBoxItem Content="串口" />
                    </ListBox>
                    <ComboBox  Grid.Row="1" Grid.Column="0"
                        x:Name="TxtSerialPorts" Margin="0,5,10,0"
                        Style="{StaticResource MaterialDesignFilledComboBox}"  
                        Text="{Binding TxtSerialPorts, UpdateSourceTrigger=PropertyChanged}" Visibility="Hidden"
                        IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}" >
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                                <materialDesign:PackIcon Kind="SerialPort" />
                                <TextBlock Text="采集端口" FontSize="14" FontWeight="Bold" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                        <ComboBoxItem Content="COM1" />
                        <ComboBoxItem Content="COM2" />
                        <ComboBoxItem Content="COM3" />
                    </ComboBox>
                    <TextBox  Grid.Row="1" Grid.Column="0"
                        x:Name="TxtTCPIP"  Margin="10,5,10,0"  Visibility="Hidden"
                        Text="{Binding TxtTCPIP, UpdateSourceTrigger=PropertyChanged}"        
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                        materialDesign:TextFieldAssist.HasClearButton="True" 
                        materialDesign:TextFieldAssist.PrefixText="" 
                        materialDesign:TextFieldAssist.SuffixText="" Cursor="IBeam">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                                <TextBlock Text="IP地址，例如：192.168.100.99:5000" FontSize="10" FontWeight="Bold" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>
                    <Viewbox x:Name="TxtBoardCase" Stretch=" Uniform" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,10,5"  Grid.Row="1" Grid.Column="0">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*"/>
                                <RowDefinition Height="100*"/>
                            </Grid.RowDefinitions>
                            <ListBox  x:Name="TxtBoardCaseList01" Grid.Row="0" Grid.Column="0"
                                      SelectionChanged="TxtBoardCaseSelect_SelectionChanged"
                                      Style="{StaticResource MaterialDesignFilterChipAccentListBox}">
                                <ListBoxItem Content="01" />
                                <ListBoxItem IsSelected="True" Content="02" />
                                <ListBoxItem Content="03" />
                                <ListBoxItem Content="04" />
                                <ListBoxItem Content="05" />
                                <ListBoxItem Content="06" />
                                <ListBoxItem Content="07" />
                                <ListBoxItem Content="08" />
                                <ListBoxItem Content="09" />
                                <ListBoxItem Content="10" />
                            </ListBox>
                            <ListBox x:Name="TxtBoardCaseList02" Grid.Row="1" Grid.Column="0"
                                      SelectionChanged="TxtBoardCaseSelect_SelectionChanged" Style="{StaticResource MaterialDesignFilterChipAccentListBox}">
                                <ListBoxItem Content="11" />
                                <ListBoxItem IsSelected="True" Content="12" />
                                <ListBoxItem Content="13" />
                                <ListBoxItem Content="14" />
                                <ListBoxItem Content="15" /> 
                            </ListBox>
                        </Grid>
                            
                    </Viewbox>
                </Grid>


                <ComboBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="1"
                    x:Name="TxtProductList"  Margin="10,0,10,5" SelectionChanged="TxtProductList_SelectionChanged" 
                    Text="{Binding TxtProductList, UpdateSourceTrigger=PropertyChanged}" 
                    DisplayMemberPath="Name"
                    Style="{StaticResource MaterialDesignFilledComboBox}"
                    IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}" >
                    <materialDesign:HintAssist.Hint>
                        <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                            <materialDesign:PackIcon Kind="FormatListBulletedType" />
                            <TextBlock Text="产品型号" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </materialDesign:HintAssist.Hint>
                    <ComboBoxItem Content="COM1" />
                    <ComboBoxItem Content="Item 2" />
                    <ComboBoxItem Content="Item 3" />
                </ComboBox>
                <TextBox  Grid.Row="0" Grid.Column="3" 
                    x:Name="TxtTimeTotal"  Margin="0,5,0,5"  PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding TxtTimeTotal, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="小时">
                    <materialDesign:HintAssist.Hint>
                        <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                            <TextBlock Text="老化倒计时" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </materialDesign:HintAssist.Hint>
                </TextBox>

                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*"/>
                        <RowDefinition Height="100*"/>
                    </Grid.RowDefinitions>
                    <StackPanel   Grid.Row="0" Grid.Column="0"
                      Orientation="Horizontal"
                      Margin="4">
                        <RadioButton
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Margin="4"
                        IsChecked="True"
                        Content="FIRST" />
                        <RadioButton
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Margin="4"
                        IsChecked="False"
                        Content="SECOND" />
                        <RadioButton
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Margin="4"
                        IsChecked="False"
                        IsEnabled="False"
                        Content="THIRD" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions> 
                        <RowDefinition Height="100*"/>
                    </Grid.RowDefinitions>



                    <ComboBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1"
                        x:Name="TxtBatchCaseSelect"  Margin="10,0,10,5" SelectionChanged="TxtBatchCaseSelect_SelectionChanged" 
                        Text="{Binding TxtProductList, UpdateSourceTrigger=PropertyChanged}" 
                        DisplayMemberPath="F_BoardCaseAddress" 
                        Style="{StaticResource MaterialDesignFilledComboBox}"
                        IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}" >
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                                <materialDesign:PackIcon Kind="FormatListBulletedType" />
                                <TextBlock Text="机柜" FontSize="14" FontWeight="Bold" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                        <ComboBoxItem Content="01" />
                        <ComboBoxItem Content="02" /> 
                    </ComboBox>
                    <Viewbox x:Name="TxtBatchCaseSelectBox" Stretch=" Uniform"
                             VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,10,5"  
                              Grid.Row="1" Grid.Column="1">
                        <ListBox x:Name="TxtBatchCaseSelectFloor"
                            DisplayMemberPath="F_FloorNO"
                            SelectionChanged="TxtBatchCaseSelectFloor_SelectionChanged" 
                             Style="{StaticResource MaterialDesignFilterChipAccentListBox}">
                            <ListBoxItem Content="1" />
                            <ListBoxItem Content="2" />
                            <ListBoxItem Content="3" />
                            <ListBoxItem Content="4" />
                            <ListBoxItem Content="5" />
                            <ListBoxItem Content="6" />
                            <ListBoxItem Content="7" />
                            <ListBoxItem Content="8" />
                            <ListBoxItem Content="9" />
                        </ListBox>
                    </Viewbox>
                    

                    <TextBox 
                        Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        x:Name="TxtSensorGrougAddress"    Visibility="Hidden"
                        Margin="10,5,10,5" PreviewKeyUp="TxtSensorGrougAddress_PreviewKeyDown"
                        PreviewKeyDown="TxtSensorGrougAddress_PreviewKeyDown"
                        Text="{Binding TxtSensorGrougAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                        materialDesign:TextFieldAssist.HasClearButton="True" 
                        materialDesign:TextFieldAssist.PrefixText="" 
                        materialDesign:TextFieldAssist.SuffixText="">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                                <!--<materialDesign:PackIcon Kind="AccessPoint" />-->
                                <TextBlock x:Name="TxtSensorGrougAddressDesc" Foreground="#FF188C8E" FontSize="14" FontWeight="Bold" Text="{Binding TxtSensorGrougAddressDesc, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>
                </Grid>
                

                <TextBox Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2"
                    x:Name="TxtProjectTitle"  Margin="10,5,10,5" 
                    Text="{Binding TxtProjectTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.HasClearButton="True" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="">
                    <materialDesign:HintAssist.Hint>
                        <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                            <!--<materialDesign:PackIcon Kind="AccessPoint" />-->
                            <TextBlock Foreground="#FF188C8E" FontSize="14" FontWeight="Bold" Text="请输入修改老化批次名称" />
                        </StackPanel>
                    </materialDesign:HintAssist.Hint>
                </TextBox>

                <Grid Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100*"/>
                        <RowDefinition Height="100*"/>
                    </Grid.RowDefinitions>
                    <TextBox  Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                    x:Name="TxtVoltageValueBase"  Margin="0,5,0,5"  PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding TxtVoltageValueBase, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                                <TextBlock Text="信号AD基准值" FontSize="14" FontWeight="Bold" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>
                    <TextBox  Grid.Row="0" Grid.Column="1" FontSize="10"
                    x:Name="TxtVoltageValueMinus"  Margin="0,5,0,0"  PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding TxtVoltageValueMinus, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:TextFieldAssist.PrefixText="-" 
                    materialDesign:TextFieldAssist.SuffixText="" >
                    </TextBox>
                    <TextBox  Grid.Row="1" Grid.Column="1" FontSize="10"
                    x:Name="TxtVoltageValueAdd"  Margin="0,0,0,5"  PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding TxtVoltageValueAdd, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:TextFieldAssist.PrefixText="+" 
                    materialDesign:TextFieldAssist.SuffixText="">
                    </TextBox>
                </Grid>
                
                <Button Grid.Row="0" Grid.Column="6" 
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnQuery}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnQuery" Content="开始老化" Background="#FF188C8E"  Margin="10,5,10,5" Cursor="Hand"/>

                <ComboBox Grid.Row="1" Grid.Column="6"  
                    x:Name="TxtBatchList"  Margin="10,0,10,5" SelectionChanged="TxtBatchList_SelectionChanged" 
                    Text="{Binding TxtBatchList, UpdateSourceTrigger=PropertyChanged}" 
                    DisplayMemberPath="F_BatchName" SelectedValuePath="F_BatchId"
                    Style="{StaticResource MaterialDesignFilledComboBox}"
                    IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}" >
                    <materialDesign:HintAssist.Hint>
                        <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                            <materialDesign:PackIcon Kind="FormatListBulletedType" />
                            <TextBlock Text="当前批次" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </materialDesign:HintAssist.Hint>
                    <ComboBoxItem Content="COM1" />
                    <ComboBoxItem Content="Item 2" />
                    <ComboBoxItem Content="Item 3" />
                </ComboBox>
       

            </Grid>
        </Border>
        <Border  Grid.Row="2" BorderThickness="1" BorderBrush="LightGray" Margin="83,0,10,10" >
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" >
                 
                <TextBlock x:Name="StaRate" VerticalAlignment="Center" 
                           Text="{Binding StaRate, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                            FontWeight="Bold" FlowDirection="LeftToRight" Width="53" Foreground="#FF17986F" />
                <Label Content="合格率" Foreground="#FF000F59" Width="49" />
                <TextBlock x:Name="StaUnqualified"  FontWeight="Bold" VerticalAlignment="Center"
                            Text="{Binding StaUnqualified, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                           Width="19" Foreground="#FFD45046" />
                <Label Content="不良品/个" Canvas.Bottom="5" Width="67" Foreground="#FF000F59" />
                <TextBlock x:Name="StaQuallified"  FontWeight="Bold" VerticalAlignment="Center"
                            Text="{Binding StaQuallified, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                            Width="37" Foreground="#FF17986F" />
                <Label Content="合格/个"  Width="61" Foreground="#FF000F59" />
                <TextBlock x:Name="StaTotal"  FontWeight="Bold" VerticalAlignment="Center"
                            Text="{Binding StaTotal, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                             Width="50" Foreground="#FF000F59" />
                <Label Content="总数/个" Width="63" Foreground="#FF000F59" />
                <Label x:Name="LabelMessage" FlowDirection="LeftToRight" Content="{Binding LabelMessage, UpdateSourceTrigger=PropertyChanged}" Width="1200" Foreground="#FF000F59" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
