<UserControl x:Class="DeviceDataMonitorWPF.UILaoHua.UILaoHuaGuanChaC10"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeviceDataMonitorWPF.UILaoHua"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1800">
    <Grid x:Name="gridrRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="43"/>
        </Grid.RowDefinitions>
        <Grid x:Name="grid" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
            </Grid.RowDefinitions>
            <local:UILaoHuaGuanChaC10Grid Grid.Column="0" Grid.Row="0" Margin="0,0,0,0" BorderThickness="9,9,1,1" BorderBrush="{DynamicResource UILaoHuaBrush}"/>
            <local:UILaoHuaGuanChaC10Grid Grid.Column="1" Grid.Row="0" Margin="0,0,3,0" BorderThickness="1,9,9,1" BorderBrush="{DynamicResource UILaoHuaBrush}" />
            <local:UILaoHuaGuanChaC10Grid Grid.Column="0" Grid.Row="1" Margin="0,0,0,0" BorderThickness="9,1,1,9" BorderBrush="{DynamicResource UILaoHuaBrush}"/>
            <local:UILaoHuaGuanChaC10Grid Grid.Column="1" Grid.Row="1" Margin="0,0,3,0" BorderThickness="1,1,9,9" BorderBrush="{DynamicResource UILaoHuaBrush}"/>
        </Grid>
        <ListBox Grid.Row="1"
              Style="{StaticResource MaterialDesignChoiceChipListBox}"
              x:Name="gridPager" SelectionChanged="gridPager_SelectionChanged">
            <ListBoxItem Content="1-2" IsSelected="True"/>
            <ListBoxItem Content="3-4" />
            <ListBoxItem Content="5-6" />
        </ListBox>
    </Grid>
</UserControl>
