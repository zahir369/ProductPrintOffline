<Window
    x:Class="DeviceDataMonitorWPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeviceDataMonitorWPF.UserCommon"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    Title="郑州美克盛世电子科技有限公司"
    Width="800"
    Height="450" 
    Background="{DynamicResource MaterialDesignPaper}"
    Loaded="Window_Loaded"
    TextElement.FontSize="14"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized" 
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">
    <Viewbox Stretch="Fill">
        <Grid Width="1920" Height="1080" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="69" />
            <ColumnDefinition Width="99*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="69" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:ColorZone
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Padding="8"
            VerticalAlignment="Center"
            Mode="PrimaryDark">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="181"
                        Height="80"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="/Resources/Images/logo5.png" />
                    <!--<ToggleButton Style="{DynamicResource MaterialDesignHamburgerToggleButton}" />-->
                    <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="22"
                        FontWeight="Bold"
                        Text="智慧工厂生产数字化管理系统" />
                    <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="v1.2" />
                </StackPanel>

                <Button
                    x:Name="btnLogout"
                    Width="40"
                    Height="40"
                    Click="btnLogout_Click"
                    Command="{Binding HomeCommand}"
                    Content="{materialDesign:PackIcon Kind=CloseBox,
                                                      Size=36}"
                    Cursor="Hand"
                    DockPanel.Dock="Right"
                    Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType={x:Type FrameworkElement}}}"
                    Style="{DynamicResource MaterialDesignToolButton}"
                    ToolTip="关闭并退出" />

                <Button Width="30" Visibility="Hidden" />
            </DockPanel>
        </materialDesign:ColorZone>

        <StackPanel
            x:Name="pnlLeftMenu"
            Grid.Row="1"
            Grid.Column="0"
            Background="{DynamicResource PrimaryHueLightBrush}"
            Orientation="Vertical" />



        <materialDesign:DrawerHost
            x:Name="dhDrawerHost"
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="0"
            OpenMode="Standard">

            <materialDesign:DrawerHost.LeftDrawerContent>
                <StackPanel
                    Width="156"
                    Margin="0"
                    Background="AliceBlue">
                    <DockPanel Margin="10">
                        <TextBlock
                            x:Name="menuTreeViewParentName"
                            Margin="6,4,0,0"
                            DockPanel.Dock="Left"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="设备管理" />
                        <Button
                            Width="25"
                            Height="25"
                            HorizontalAlignment="Right"
                            Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}"
                            CommandParameter="{x:Static Dock.Left}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}">
                            <materialDesign:PackIcon
                                Width="22"
                                Height="22"
                                Kind="ArrowLeftThinCircleOutline" />
                        </Button>
                    </DockPanel>

                    <TreeView
                        x:Name="menuTreeView"
                        Margin="0"
                        SelectedItemChanged="menuTreeView_SelectedItemChanged">

                        <!--<TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <EventSetter Event="Selected" Handler="item_SelectedItemChanged" />
                                <Setter Property="Margin" Value="-10,10,0,8" />
                                <Setter Property="FontSize" Value="14" />
                            </Style>
                        </TreeView.ItemContainerStyle>-->

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Path=MenuDataChilds}">
                                <StackPanel Margin="-5,0,0,0" Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20">
                                        <materialDesign:PackIcon Kind="HandPointingRight" />
                                    </Viewbox>
                                    <TextBlock Margin="2,0,0,0" Text="{Binding MenuName}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>

                        <!--<DataTemplate DataType="{x:Type local:MenuTreeItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NamePlaylist}" />
                            </StackPanel>
                        </DataTemplate>-->
                        <!--<TreeViewItem Margin="-30,0,0,0">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16">
