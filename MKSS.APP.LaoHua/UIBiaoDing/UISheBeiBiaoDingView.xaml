<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MKSS.APP.UIBiaoDing"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:LaoHua="clr-namespace:MKSS.APP.LaoHua" 
             x:Class="MKSS.APP.UIBiaoDing.UISheBeiBiaoDingView"
             mc:Ignorable="d" Foreground="Black" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:s="https://github.com/canton7/Stylet" 
             Unloaded="UserControl_Unloaded"  Background="White"
             d:DataContext="{d:DesignInstance local:UISheBeiBiaoDingViewModel}"
             d:DesignHeight="1080" d:DesignWidth="1920">
    <UserControl.DataContext>
        <local:UISheBeiBiaoDingViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <SolidColorBrush x:Key="MTextcolorBrush" Color="#FF233177" />
        <Style x:Key="MaterialDesignFloatingHintTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
            <Setter Property="Foreground" Value="#FF233177"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0 0 0 -40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.RowSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="100*"/>
                <RowDefinition Height="39"/>
            </Grid.RowDefinitions>
            <local:UISheBeiBiaoDingCQT x:Name="UISheBeiBiaoDingCQT" Grid.Row="1" Grid.Column="1" Margin="10,10,10,10"/>

        </Grid>


        <Border 
            Grid.Row="0" BorderThickness="1" BorderBrush="LightGray"  
            materialDesign:ShadowAssist.ShadowDepth="Depth4"
                Margin="15,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80*"/>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="40*"/>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*"/>
                    <RowDefinition Height="100*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100*"/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" Grid.Column="0"  Margin="10,5,0,5" x:Name="TxtPortsModeSelect"
                        Style="{StaticResource MaterialDesignChoiceChipListBox}"
                        SelectionChanged="TxtPortsModeSelect_SelectionChanged" >
                        <ListBoxItem IsSelected="True" Content="局域网" />
                        <ListBoxItem Content="串口" />
                        <ListBoxItem Content="老化柜" PreviewMouseUp="ListBoxItem_MouseUp" />
                    </ListBox>
                    <ComboBox  Grid.Row="0" Grid.Column="1"
                        x:Name="TxtSerialPorts" Margin="0,5,10,0"
                        Style="{StaticResource MaterialDesignFilledComboBox}" PreviewMouseUp="TxtSerialPorts_PreviewMouseUp"  
                        Text="{Binding TxtSerialPorts, UpdateSourceTrigger=PropertyChanged}" Visibility="Hidden"
                        IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}" >
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                                <materialDesign:PackIcon Kind="SerialPort" />
                                <TextBlock x:Name="TxtSerialPortsDesc"  Text="{Binding TxtSerialPortsDesc, UpdateSourceTrigger=PropertyChanged}"  FontSize="14" FontWeight="Bold" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                        <ComboBoxItem Content="COM1" />
                        <ComboBoxItem Content="COM2" />
                        <ComboBoxItem Content="COM3" />
                    </ComboBox>
                    <TextBox  Grid.Row="0" Grid.Column="2"
                        x:Name="TxtTCPIP"  Margin="10,5,10,0" 
                        Text="{Binding TxtTCPIP, UpdateSourceTrigger=PropertyChanged}"        
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                        materialDesign:TextFieldAssist.HasClearButton="True" 
                        materialDesign:TextFieldAssist.PrefixText="" 
                        materialDesign:TextFieldAssist.SuffixText="" Cursor="IBeam">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                                <TextBlock Text="IP地址，例如：192.168.100.99:5000" FontSize="10" FontWeight="Bold" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>
                </Grid>


                <ComboBox Grid.Row="1" Grid.Column="0"
                    x:Name="TxtProductList"  Margin="10,0,170,5" SelectionChanged="TxtProductList_SelectionChanged" 
                    Text="{Binding TxtProductList, UpdateSourceTrigger=PropertyChanged}" 
                    DisplayMemberPath="Name"
                    Style="{StaticResource MaterialDesignFilledComboBox}"
                    IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}" >
                    <materialDesign:HintAssist.Hint>
                        <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                            <materialDesign:PackIcon Kind="FormatListBulletedType" />
                            <TextBlock Text="产品型号" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </materialDesign:HintAssist.Hint>
                    <ComboBoxItem Content="COM1" />
                    <ComboBoxItem Content="Item 2" />
                    <ComboBoxItem Content="Item 3" />
                </ComboBox>
                <materialDesign:Badged x:Name="BtnScrwdTip" Grid.Row="1" Grid.Column="0" BadgeColorZoneMode="SecondaryMid" HorizontalAlignment="Right" Margin="10,11,10,5"
                  Badge="{Binding BtnScrwdTipBadge, UpdateSourceTrigger=PropertyChanged}">
                    <Button Width="150"  
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnScrwd}"
                    materialDesign:ButtonAssist.CornerRadius="2" BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnScrwd" Content="  任务单" ToolTip="请选择所属任务单" Background="#FF79B42E" Cursor="Hand"/>
                </materialDesign:Badged>



                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*"/>
                        <RowDefinition Height="100*"/>
                    </Grid.RowDefinitions>
                    <StackPanel   Grid.Row="0" Grid.Column="0"
                      Orientation="Horizontal"
                      Margin="4">
                        <RadioButton
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Margin="4"
                        IsChecked="True"
                        Content="FIRST" />
                        <RadioButton
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Margin="4"
                        IsChecked="False"
                        Content="SECOND" />
                        <RadioButton
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Margin="4"
                        IsChecked="False"
                        IsEnabled="False"
                        Content="THIRD" />
                    </StackPanel>
                    <Button  Grid.Row="1" Grid.Column="0" Margin="10,0,10,5"
                        Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnConnect}"
                        materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0" materialDesign:ShadowAssist.ShadowDepth="Depth1"
                        x:Name="BtnConnect" Content="连接" Background="#FF179698" Cursor="Hand"/>
                </Grid>

                <Button  Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnDisConnect}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnDisConnect" Content="断开" Background="#FFD33F34"  Margin="10,5,10,5" Cursor="Hand"/>



                <TextBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="1"
                    x:Name="TxtSensorGrougAddress"  Margin="10,5,10,5" PreviewKeyDown="TxtSensorGrougAddress_PreviewKeyDown"
                    Text="{Binding TxtSensorGrougAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.HasClearButton="True" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="">
                    <materialDesign:HintAssist.Hint>
                        <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                            <!--<materialDesign:PackIcon Kind="AccessPoint" />-->
                            <TextBlock x:Name="TxtSensorGrougAddressDesc" Foreground="#FF188C8E" FontSize="14" FontWeight="Bold" Text="{Binding TxtSensorGrougAddressDesc, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </materialDesign:HintAssist.Hint>
                </TextBox>


                <Button  Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="1"
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnQueryParameter}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0" materialDesign:ShadowAssist.ShadowDepth="Depth1"
                    x:Name="BtnQueryParameter" Content="{Binding BtnQueryParameterText}" Background="{Binding BtnQueryParameterBackground}"  Margin="10,5,10,5"/>

                <Button Grid.Row="0" Grid.Column="4" 
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnReadSerialNo}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0" materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnReadSerialNo" Content="读取序列号"  ToolTip="读取序列号" Background="#FF366BC3"  Margin="10,5,10,5" Cursor="Hand"/>
                <Button Grid.Row="1" Grid.Column="4"  
                    Style="{StaticResource MaterialDesignRaisedButton}"  
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                    x:Name="BtnReadTime" s:View.ActionTarget="{Binding}" Command="{s:Action BtnReadTime}" 
                    Content="读取设备时间" ToolTip="读取传感器时间、传感器出厂日期" Background="#FF358CD4"  Margin="10,5,10,5" />
                <Button  Grid.Row="0" Grid.Column="3" 
                    Style="{StaticResource MaterialDesignRaisedButton}"  
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                    x:Name="BtnSetSerialNo" s:View.ActionTarget="{Binding}" Command="{s:Action BtnSetSerialNo}"
                              Content="生成序列号"  ToolTip="写入序列号" Background="#FFD33F34"  Margin="10,5,10,5"/>
                <Button Grid.Row="1" Grid.Column="3"  
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                    x:Name="BtnSetTime" s:View.ActionTarget="{Binding}" Command="{s:Action BtnSetTime}" 
                     Content="登记设备时间" ToolTip="写入传感器时间、传感器出厂日期" Background="#FFD33F34"  Margin="10,5,10,5"/>

                <Button Grid.Row="1" Grid.Column="5" 
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnExport}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnExport" Content="导出结果" Background="#FF0029FF" Margin="10,5,10,5" Cursor="Hand"/>

                <Button Grid.Row="0" Grid.Column="5" 
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnStartBatch}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnStartBatch" Content="开始老化" Background="#FF17986F" Margin="10,5,10,5" Cursor="Hand"/>

            </Grid>
        </Border>
        <Border  Grid.Row="2" BorderThickness="1" BorderBrush="LightGray">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Left" 
                        FlowDirection="RightToLeft" Margin="17,0,0,0" Width="1901" >
                <!--<CheckBox x:Name="StaReadSerialNo" Content="读取串号" 
                          IsChecked="{Binding StaReadSerialNo, UpdateSourceTrigger=PropertyChanged}"
                             />
                <CheckBox x:Name="StaFilterEmpSata" Content="滤波" 
                          IsChecked="{Binding StaFilterEmpSata, UpdateSourceTrigger=PropertyChanged}"
                             />-->
                <!--<CheckBox x:Name="StaZeroSpanTitleExchange"  IsChecked="{Binding StaZeroSpanTitleExchange, UpdateSourceTrigger=PropertyChanged}"
                          Unchecked="StaZeroSpanTitleExchange_Checked"  
                          Content="名称对调" Width="83" Checked="StaZeroSpanTitleExchange_Checked" />-->
                <TextBlock x:Name="StaTimeElapsed" FontWeight="Bold" VerticalAlignment="Center" 
                           TextWrapping="Wrap" Text="{Binding StaTimeElapsed, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Width="300" Foreground="#FF000F59"  />
                <Label Content="历时" Foreground="#FF000F59" />
                <TextBlock x:Name="StaRate" VerticalAlignment="Center" 
                           Text="{Binding StaRate, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                            FontWeight="Bold" FlowDirection="LeftToRight" Width="80" Foreground="#FF17986F" />
                <Label Content="合格率" Foreground="#FF000F59" Width="60" />
                <TextBlock x:Name="StaUnqualified"  FontWeight="Bold" VerticalAlignment="Center"
                            Text="{Binding StaUnqualified, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                           Width="60" Foreground="#FFD45046" />
                <Label Content="不良品/个" Canvas.Bottom="5" Width="67" Foreground="#FF000F59" />
                <TextBlock x:Name="StaQuallified"  FontWeight="Bold" VerticalAlignment="Center"
                            Text="{Binding StaQuallified, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                            Width="60" Foreground="#FF17986F" />
                <Label Content="合格/个"  Width="61" Foreground="#FF000F59" />
                <TextBlock x:Name="StaTotal"  FontWeight="Bold" VerticalAlignment="Center"
                            Text="{Binding StaTotal, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                             Width="60" Foreground="#FF000F59" />
                <Label Content="总数/个" Width="63" Foreground="#FF000F59" />

                <TextBlock x:Name="StaSelectedAverage"  FontWeight="Bold" VerticalAlignment="Center"
                            Text="{Binding StaSelectedAverage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                             Width="60" Foreground="#FF000F59" />
                <Label Content="平均值" Width="63" Foreground="#FF000F59" />

                <TextBlock x:Name="StaSelectedCount"  FontWeight="Bold" VerticalAlignment="Center"
                            Text="{Binding StaSelectedCount, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                             Width="60" Foreground="#FF000F59" />
                <Label Content="选中/个" Width="63" Foreground="#FF000F59" />

                <Label x:Name="LabelMessage" FlowDirection="LeftToRight" Content="{Binding LabelMessage, UpdateSourceTrigger=PropertyChanged}" Width="844" Foreground="#FF000F59" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
