<Window
    x:Class="MKSS.APP.LaoHua.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MKSS.APP.LaoHua.UserCommon"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:UILaoHua="clr-namespace:MKSS.APP.LaoHua"
    xmlns:UIBiaoDing="clr-namespace:MKSS.APP.UIBiaoDing"
    Title="郑州美克盛世电子科技有限公司"
    Width="800"
    Height="450" 
    Background="{DynamicResource  PrimaryHueLightBrush}"
    TextElement.FontSize="14"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized" 
    WindowStyle="SingleBorderWindow" Loaded="Window_Loaded"
    mc:Ignorable="d">
    <Viewbox Stretch="Fill">
        <Grid Width="1920" Height="1080" Background="{DynamicResource  PrimaryHueLightBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="674" />
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="119" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UILaoHua:UILaoHuaGuanCha Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0"/>

            <materialDesign:ColorZone
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Padding="8" 
                VerticalAlignment="Center"
                Mode="PrimaryDark">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="MainLogo"
                        Width="368"
                        Height="120"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="/Resources/Images/logo2.png" />
                        <TextBlock x:Name="MainSubTile"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="43"
                        FontWeight="Bold"
                        Text="智慧工厂生产数字化管理系统-老化/观察软件" />
                        <TextBlock x:Name="MainSubVersion"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="v3.7Ue" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Width="600">
                            <TextBox Margin="10,2,0,2" Width="200"
                                x:Name="TxtUserAdmin"    FlowDirection="LeftToRight"
                                ToolTip="核验人" FontSize="16" Foreground="White"   Text="***"
                                materialDesign:TextFieldAssist.PrefixText="核验人" 
                                materialDesign:TextFieldAssist.SuffixText="" Cursor="IBeam">
                            </TextBox>
                            <TextBox Margin="10,2,0,2" Width="200"
                                x:Name="TxtUser"  FlowDirection="LeftToRight"
                                ToolTip="操作人" FontSize="16" Foreground="White"  Text="***"
                                materialDesign:TextFieldAssist.PrefixText="操作人" 
                                materialDesign:TextFieldAssist.SuffixText="" Cursor="IBeam">
                            </TextBox>
                        </StackPanel>
                    </StackPanel>
 
                </DockPanel>
            </materialDesign:ColorZone>


        </Grid>
    </Viewbox>
</Window>
