<UserControl x:Class="MKSS.APP.O2Tester.UIZhuiSuC10Setting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MKSS.APP.O2Tester" Loaded="UserControl_Loaded"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"  d:DesignHeight="600" d:DesignWidth="360" >
    <UserControl.DataContext>
        <local:UIZhuiSuC10SettingModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <local:NullableDecimalConverter x:Key="DecimalConverter"/>
    </UserControl.Resources>
    <Grid Margin="10,10,10,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="16*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="78"/> 
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="16" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="0*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="6*"/>
            </Grid.RowDefinitions>


            <Label x:Name="RefreshProgressText" Height="32" 
               HorizontalAlignment="Left" Content="00:00:00" FontSize="21"  Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"  
               Margin="13,1,0,0" BorderThickness="0,0,0,0" BorderBrush="#FF394376"  VerticalContentAlignment="Center"
               Foreground="{DynamicResource FontColorStart}" />
            <Label x:Name="FullQueryTimesText" Height="32"   
               HorizontalAlignment="Left" Content="0000000" FontSize="21"  Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2"  
               Margin="-10,1,28,0" BorderThickness="0,0,0,0" BorderBrush="#FF394376"  VerticalContentAlignment="Center"
               Foreground="{DynamicResource FontColorStart}" />
            
            <Button Grid.Column="2" Margin="0,0,10,0" Background="#FF112B61" BorderThickness="0"
                    x:Name="BtnExcelExport" Click="BtnExcelExport_Click"   HorizontalAlignment="Right" Width="106"
                    IsEnabled="{Binding CanBtnExcelExport, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32"    
                    ToolTip="" Cursor="Hand">
                <TextBlock Text="导出(E)" />
            </Button>

            <ProgressBar HorizontalAlignment="Right" Value="100"  VerticalAlignment="Top" Visibility="Hidden"
              x:Name="RefreshProgress" Grid.Column="2" Grid.Row="0" Width="16" Grid.RowSpan="2"  
              Style="{StaticResource MaterialDesignCircularProgressBar}" />

            <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    materialDesign:TextFieldAssist.PrefixText="型号："
                    materialDesign:HintAssist.Hint="Search" Visibility="Hidden"
                    materialDesign:HintAssist.HintOpacity=".26"
                    x:Name="TxtProductList" Margin="10,2,0,2" SelectionChanged="TxtProductList_SelectionChanged" 
                    Text="{Binding TxtProductList, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding CanTxtProductList, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                    DisplayMemberPath="Name" >
            </ComboBox>
            <ComboBox Grid.Row="1" Grid.Column="2"
                    materialDesign:TextFieldAssist.PrefixText="规格："  Visibility="Hidden"
                    x:Name="TxtModelList" Margin="10,2,10,2" SelectionChanged="TxtModelList_SelectionChanged" 
                    Text="{Binding TxtModelList, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding CanTxtModelList, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                    DisplayMemberPath="Name" >
            </ComboBox>
            <Button Grid.Row="1" Grid.Column="2" Margin="10,2,10,2" HorizontalAlignment="Right" Style="{StaticResource  MaterialDesignFlatAccentBgButton}" ToolTip="新增规格" Click="Button_Click" Width="10" Height="10">
                <materialDesign:PackIcon Kind="PlusThick" Height="10" Width="10" />
            </Button>
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*"/> 
                </Grid.RowDefinitions>

                <TextBox 
                    Grid.Row="0" Grid.Column="0" Margin="3,5,3,5"
                    x:Name="TxtV1" 
                    Text="" 
                    IsEnabled="True" IsReadOnly="True"
                    ToolTip="开始注气时间,秒钟" GotFocus="TxtV1_GotFocus"
                    materialDesign:TextFieldAssist.PrefixText="V1：" 
                    materialDesign:TextFieldAssist.SuffixText="秒" Cursor="IBeam">
                </TextBox>
                <TextBox 
                    Grid.Row="0" Grid.Column="1" Margin="3,5,10,5"
                    x:Name="TxtV2"  
                    Text="" 
                    IsEnabled="True" IsReadOnly="True"
                    ToolTip="开始散气时间,秒钟" GotFocus="TxtV1_GotFocus"
                    materialDesign:TextFieldAssist.PrefixText="V2：" 
                    materialDesign:TextFieldAssist.SuffixText="秒" Cursor="IBeam">
                </TextBox>
                <TextBox 
                    Grid.Row="0" Grid.Column="2" Margin="3,5,3,5"
                    x:Name="TxtV3" 
                    Text="" 
                    IsEnabled="True" IsReadOnly="True"
                    ToolTip="散气结束时间,秒钟" GotFocus="TxtV1_GotFocus"
                    materialDesign:TextFieldAssist.PrefixText="V3：" 
                    materialDesign:TextFieldAssist.SuffixText="秒" Cursor="IBeam">
                </TextBox>
                <TextBox 
                    Grid.Row="0" Grid.Column="3" Margin="3,5,3,5"
                    x:Name="TxtT90" 
                    Text="" 
                    IsEnabled="True" IsReadOnly="True"
                    ToolTip="T90,秒钟" GotFocus="TxtV1_GotFocus"
                    materialDesign:TextFieldAssist.PrefixText="T90：" 
                    materialDesign:TextFieldAssist.SuffixText="秒" Cursor="IBeam">
                </TextBox>
                <TextBox 
                    Grid.Row="0" Grid.Column="4" Margin="3,5,3,5"
                    x:Name="TxtT10" 
                    Text="" 
                    IsEnabled="True" IsReadOnly="True"
                    ToolTip="T10,秒钟" GotFocus="TxtV1_GotFocus"
                    materialDesign:TextFieldAssist.PrefixText="T10：" 
                    materialDesign:TextFieldAssist.SuffixText="秒" Cursor="IBeam">
                </TextBox>
            </Grid>

            <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                    materialDesign:TextFieldAssist.PrefixText="采样时间："
                    materialDesign:TextFieldAssist.SuffixText="秒" 
                    x:Name="TxtTestTimePoints" Margin="0,5,0,5" TextChanged="TxtTestTimePoints_TextChanged" 
                    Text="{Binding TxtTestTimePoints, UpdateSourceTrigger=PropertyChanged}" 
                    IsEnabled="{Binding CanTxtTestTimePoints, UpdateSourceTrigger=PropertyChanged}" ToolTip="最多10个，包含零点时间（T90时间时间）和反应时间（O₂浓度）"  >

            </TextBox>


        </Grid>

        <!--<Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="15" Grid.RowSpan="4" BorderThickness="2,2,2,2" BorderBrush="{DynamicResource BgColorBBoard}">
            <Border  Margin="10,0,0,0" Width="110" HorizontalAlignment="Center" BorderThickness="2,0,2,0" BorderBrush="{DynamicResource BgColorBBoard}">

            </Border>
        </Border>-->

        <Label Margin="0,7,0,-7" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3"  HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock TextWrapping="NoWrap" x:Name="SrcTitle" Text="O₂浓度" />
        </Label>

        <Label Margin="0,7,0,-7" Grid.Column="5" Grid.Row="1" Grid.ColumnSpan="5"   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock TextWrapping="NoWrap" Text="T90时间" />
        </Label>

        <Label Margin="0,7,0,-7" Grid.Column="11" Grid.Row="1" Grid.ColumnSpan="3"   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock TextWrapping="NoWrap" Text="T10时间" />
        </Label>
        
        <ItemsControl  Grid.Column="0" Grid.Row="2"  Grid.ColumnSpan="16" Margin="1,3,1,6" Height="230"  HorizontalAlignment="Center" 
             x:Name="UIZhuiSuC10MM" Background="Transparent">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Vertical" ItemHeight="35"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="5,0,0,0">
                        <StackPanel Width="125" Margin="2,0,1,0" Orientation="Horizontal">
                            <Label  Tag="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" FontSize="18"  Margin="3,1,0,0" BorderThickness="0,0,0,0" BorderBrush="#FF394376" Width="53" Content="{Binding GradeStart, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Foreground="{DynamicResource FontColorStart}" />
                            <Label  Background="{Binding GradeColor, UpdateSourceTrigger=PropertyChanged }" Tag="{Binding Tag, UpdateSourceTrigger=PropertyChanged,Mode=OneWay}"  Width="16" Margin="1,5,1,0" Cursor="Hand" MouseDown="ButtonColorSelect_Click" />
                            <TextBox FontSize="19" Text="{Binding GradeEnd, UpdateSourceTrigger=PropertyChanged,Mode=OneWay, Converter={StaticResource DecimalConverter}}" Tag="{Binding Tag, UpdateSourceTrigger=PropertyChanged }" Margin="0,1,3,0"  BorderThickness="1,1,1,1" BorderBrush="#FF394376" Width="51" Foreground="{DynamicResource FontColorStart}" LostFocus="TextBox_LostFocus" PreviewKeyDown="TextBox_PreviewKeyDown"  />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3" Grid.ColumnSpan="16" Margin="0,0,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="39"/>
                <RowDefinition Height="39"/>
            </Grid.RowDefinitions>


            <ComboBox  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,-0,0,-2"
                    x:Name="TxtSerialPorts"  
                    materialDesign:TextFieldAssist.PrefixText="串口"  PreviewMouseUp="TxtSerialPorts_PreviewMouseUp" 
                    Text="{Binding TxtSerialPorts, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding CanTxtSerialPorts, UpdateSourceTrigger=PropertyChanged}" >
                <ComboBoxItem Content="COM1" />
                <ComboBoxItem Content="COM2" />
                <ComboBoxItem Content="COM3" />
            </ComboBox>

            <TextBox 
                    Grid.Row="0" Grid.Column="2" Margin="10,5,3,5" Grid.ColumnSpan="3"
                    x:Name="TxtTotalSpan" TextChanged="TxtTotalSpan_TextChanged" 
                    Text="{Binding TxtTotalSpan, UpdateSourceTrigger=PropertyChanged}" 
                    IsEnabled="{Binding CanTxtTotalSpan, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="测试总时长,秒钟"
                    materialDesign:TextFieldAssist.PrefixText="总时长：" 
                    materialDesign:TextFieldAssist.SuffixText="秒" Cursor="IBeam">
            </TextBox>

            <TextBox  Grid.Row="0" Grid.Column="5"  
                    Margin="10,5,3,5"  Grid.ColumnSpan="3"
                    x:Name="TxtCurrentSpanValue" PreviewKeyDown="Txt_InputNumber"
                    Text="20.9"
                    IsEnabled="{Binding CanBtnStart, UpdateSourceTrigger=PropertyChanged}" 
                    ToolTip="标定浓度"
                    materialDesign:TextFieldAssist.PrefixText="标定浓度：" 
                    materialDesign:TextFieldAssist.SuffixText="%" Cursor="IBeam" > 
            </TextBox>

            <Button Style="{StaticResource MaterialDesignFloatingActionMiniAccentButton}"
                Grid.Column="2" Grid.Row="0" Width="16" Height="16" Margin="0,0,20,0"
                ToolTip="出现错误。" Name="ErrorInfo" Visibility="Hidden" >
                <materialDesign:PackIcon Kind="ExclamationThick" Height="10" Width="10" />
            </Button>
            <!--<Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="15" Grid.RowSpan="4" BorderThickness="2,2,2,2" BorderBrush="{DynamicResource BgColorBBoard}">
                <Border  Margin="10,0,0,0" Width="110" HorizontalAlignment="Center" BorderThickness="2,0,2,0" BorderBrush="{DynamicResource BgColorBBoard}">

                </Border>
            </Border>-->

            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#3275fd"
                    x:Name="BtnStart" Click="BtnStart_Click" BorderThickness="0"
                    IsEnabled="{Binding CanBtnStart, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32" Cursor="Hand">
                <TextBlock Text="开始(S)" />
            </Button>

            
            <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Background="#3275fd"
                    x:Name="BtnPause" Click="BtnPause_Click" BorderThickness="0" 
                    IsEnabled="{Binding CanBtnPause, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32" Cursor="Hand">
                <TextBlock Text="暂停(P)" />
            </Button>

            <Button Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Background="#FF7938B9"
                    x:Name="BtnFinish" Click="BtnFinish_Click" BorderThickness="0" BorderBrush="#FF7938B9"
                    IsEnabled="{Binding CanBtnFinish, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"  FontSize="15" FontWeight="Bold" 
                    Height="32" Cursor="Hand">
                <TextBlock Text="结束(Q)" />
            </Button>

            <Button Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="2" Background="#FF2C935A"
                    x:Name="BtnSetSpan" BorderThickness="0" Click="BtnSetSpan_Click"
                    IsEnabled="{Binding CanBtnStart, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32" Cursor="Hand">
                <TextBlock Text="标定浓度(B)" />
            </Button>
 
        </Grid>

    </Grid>
</UserControl>
