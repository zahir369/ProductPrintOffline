<Window x:Class="ColorBoxTest.ColorSelect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ncore="clr-namespace:ColorBox" 
        Title="请选择颜色" Height="355" Width="350" WindowStartupLocation="CenterScreen"
         ResizeMode="NoResize" ShowInTaskbar="False">
    <Canvas>
        <Button x:Name="ColorButton1" Background="{Binding Brush, ElementName=ColorBox1}" Width="323" Height="270" Canvas.Left="5" Canvas.Top="2"/>
        <ncore:ColorBox  x:Name="ColorBox1" Width="260" Canvas.Left="22" Canvas.Top="10"/>
        <Button x:Name="BtnConfirm" Content="确定" Canvas.Right="15" Canvas.Bottom="6" Click="BtnConfirm_Click"/>
        <Button x:Name="BtnCancel" Content="取消" Canvas.Right="100" Canvas.Bottom="6" Click="BtnCancel_Click"/>
    </Canvas>

</Window>
