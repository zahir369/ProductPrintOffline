<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:UIBiaodingJiuJing="clr-namespace:MKSS.APP.UIBiaoDing.UIBiaodingJiuJing"
    xmlns:UIBiaoDing="clr-namespace:MKSS.APP.UIBiaoDing"
    x:Class="MKSS.APP.UIBiaoDing.MainView" 
    xmlns:local="clr-namespace:MKSS.APP.UIBiaoDing" 
    xmlns:s="https://github.com/canton7/Stylet"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:MainViewModel}"
    Title="郑州美克盛世电子科技有限公司"
    Width="800"
    Height="450" 
    Background="{DynamicResource MaterialDesignPaper}"
    TextElement.FontSize="14"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal" 
    TextOptions.TextRenderingMode="Auto" WindowState="Maximized"
    WindowStartupLocation="CenterScreen"   >
    <Viewbox Stretch="Fill">
        <Grid Width="1920" Height="1080" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="674" />
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="119" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <materialDesign:ColorZone
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Padding="8" Height="120"
            VerticalAlignment="Center" Background="{DynamicResource PrimaryHueLightBrush}"
            Mode="PrimaryDark">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="MainLogo"
                        Width="250"
                        Height="80"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="/Resources/Images/logo5.png" />
                        <TextBlock x:Name="MainSubTile"
                        Margin="10,29,0,29"
                        VerticalAlignment="Center"
                        FontSize="36"
                        FontWeight="Bold"
                        Text="智慧工厂生产数字化管理系统-标定软件" />
                        <TextBlock x:Name="MainSubVersion"
                        Margin="16,33,0,33"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="v3.7F" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Width="925">
                            <TextBox Margin="10,2,0,2" Width="200"
                                x:Name="TxtUserAdmin"    FlowDirection="LeftToRight"
                                ToolTip="核验人" FontSize="16" Foreground="White"   Text="***"
                                materialDesign:TextFieldAssist.PrefixText="核验人" 
                                materialDesign:TextFieldAssist.SuffixText="" Cursor="IBeam">
                            </TextBox>
                            <TextBox Margin="10,2,0,2" Width="200"
                                x:Name="TxtUser"  FlowDirection="LeftToRight"
                                ToolTip="操作人" FontSize="16" Foreground="White"  Text="***"
                                materialDesign:TextFieldAssist.PrefixText="操作人" 
                                materialDesign:TextFieldAssist.SuffixText="" Cursor="IBeam">
                            </TextBox>
                        </StackPanel>
                    </StackPanel>

                </DockPanel>
            </materialDesign:ColorZone>
 
            <materialDesign:DrawerHost
            x:Name="dhDrawerHost"
            Grid.Row="1"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="0"
            OpenMode="Standard" Grid.ColumnSpan="2">
                <UIBiaoDing:UISheBeiBiaoDingView/>
            </materialDesign:DrawerHost>
            
        </Grid>
    </Viewbox>
</Window>
