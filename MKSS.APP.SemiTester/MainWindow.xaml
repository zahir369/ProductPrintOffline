<Window
    x:Class="DeviceDataMonitorWPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:local="clr-namespace:MKSS.APP.SemiTester"
    Title=有限公司"
    Width="800"
    Height="450" 
    Background="{DynamicResource  PrimaryHueLightBrush}"
    TextElement.FontSize="14"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized" PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_PreviewKeyUp" 
    WindowStyle="SingleBorderWindow" Closing="Window_Closing" Closed="Window_Closed" Loaded="Window_Loaded"
    mc:Ignorable="d">
     
    <Viewbox Stretch="Fill">
        <Grid Width="1920" Height="1080" Background="{DynamicResource  PrimaryHueLightBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="73" />
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <materialDesign:DrawerHost
                x:Name="dhDrawerHost"
                Grid.Row="1" 
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0" Grid.RowSpan="2"
                OpenMode="Standard" Grid.ColumnSpan="2">
                <local:UIZhuiSu/>

            </materialDesign:DrawerHost>
            
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="200*" />
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="200*" />
                    <ColumnDefinition Width="430" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Label Grid.Column="1" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" Content="专注传感技术 助力智慧生活"/>
                <Label Grid.Column="2"  FontSize="15" FontWeight="Bold"  HorizontalAlignment="Center" Content="Copyright © 2021 - 2030"/>
                <Label Grid.Column="3"  FontSize="15" FontWeight="Bold" HorizontalAlignment="Left" Content="深圳市美克森电子有限公司"/>
                <Button Grid.Row="4" Grid.Column="10"   Grid.ColumnSpan="5" Margin="132,-6,0,0" Background="#FF7938B9"
                    x:Name="BtnFinish" Click="BtnFinish_Click" BorderThickness="0" BorderBrush="#FF7938B9"
                    IsEnabled="{Binding CanBtnFinish, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}"  HorizontalAlignment="Left" Width="113"
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32" Cursor="Hand">
                    <TextBlock Text="结束(Q)" />
                </Button>
                <Button Grid.Column="4" Margin="272,-6,0,0" Background="#FF741348" BorderThickness="0"
                    x:Name="BtnExit" Click="BtnExit_Click"   HorizontalAlignment="Left" Width="136" 
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32" Cursor="Hand">
                    <TextBlock Text="退出系统(U)" />
                </Button>
            </Grid>


            <materialDesign:ColorZone
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Padding="0" 
                VerticalAlignment="Center"
                Mode="PrimaryDark">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image
                        Width="236"
                        Height="80"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="/Resources/Images/logo5.png" />
                        <TextBlock
                        Margin="-20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="32"
                        FontWeight="Bold"
                        Text="智慧工厂生产数字化管理系统-半导体传感器测试系统" />
                        <TextBlock x:Name="VoltageTag"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="3.0V" />
                        
                        <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="v2.3S1" />

                        
                    </StackPanel>
                    <Label x:Name="TimeNow" Grid.Row="2" Foreground="LightGray" Content="2021-02-02 12:00:00" VerticalAlignment="Bottom" Margin="560,0,20,0" HorizontalAlignment="Right" FontSize="15"  FontWeight="Bold"  />

                    <ToggleButton Visibility="Hidden"  x:Name="ToggleDarkStyle" Margin="-80 0 0 0 " Click="ToggleButton_Click"  />
                    <Button Width="30" Visibility="Hidden" />
                    
                </DockPanel>
            </materialDesign:ColorZone>


        </Grid>
    </Viewbox>
</Window>
