<Window x:Class="MKSS.APP.SemiTester.UIAddModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:MKSS.APP.SemiTester"
        mc:Ignorable="d" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Title="添加规格" Height="160" Width="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32*" />
            <ColumnDefinition Width="32*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="32*" />
            <RowDefinition Height="32*" />
        </Grid.RowDefinitions>

        <TextBox  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        x:Name="TxtNewValue"  Margin="10,0,10,0" 
                        Text="未命名"         
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                        materialDesign:TextFieldAssist.HasClearButton="True" 
                        materialDesign:TextFieldAssist.PrefixText=""  ToolTip="新规格，例如：客户简称、规格简称等"
                        materialDesign:TextFieldAssist.SuffixText="" Cursor="IBeam">
            <materialDesign:HintAssist.Hint>
                <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                    <TextBlock x:Name="TxtNewValueDesc" Text="新规格，例如：客户简称、规格简称等" ToolTip="新规格，例如：客户简称、规格简称等" FontSize="10" FontWeight="Bold" />
                </StackPanel>
            </materialDesign:HintAssist.Hint>
        </TextBox>

        <Button Grid.Column="0" Grid.Row="2"  
                    Style="{StaticResource MaterialDesignRaisedButton}"  Margin="15,3,10,0" Click="BtnCance_Click"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0" materialDesign:ShadowAssist.ShadowDepth="Depth1"
                    x:Name="BtnCance" Content="取消" Background="Blue" />

        <Button Grid.Column="1" Grid.Row="2"  
                    Style="{StaticResource MaterialDesignRaisedButton}"  Margin="15,3,10,0" Click="BtnAdd_Click"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0" materialDesign:ShadowAssist.ShadowDepth="Depth1"
                    x:Name="BtnAdd" Content="添加" Background="#FF0B9F57" />
        
    </Grid>


</Window>
