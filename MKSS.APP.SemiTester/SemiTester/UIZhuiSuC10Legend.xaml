<UserControl x:Class="MKSS.APP.SemiTester.UIZhuiSuC10Legend"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MKSS.APP.SemiTester" Loaded="UserControl_Loaded"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"  d:DesignHeight="360" d:DesignWidth="360" >
    <UserControl.DataContext>
        <local:UIZhuiSuC10SettingModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <local:NullableDecimalConverter x:Key="DecimalConverter"/>
    </UserControl.Resources>
    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="14*"/>
            <RowDefinition Height="14*"/>
            <RowDefinition Height="14*"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>
        
        <!--<Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="15" Grid.RowSpan="4" BorderThickness="2,2,2,2" BorderBrush="{DynamicResource BgColorBBoard}">
            <Border  Margin="10,0,0,0" Width="110" HorizontalAlignment="Center" BorderThickness="2,0,2,0" BorderBrush="{DynamicResource BgColorBBoard}">

            </Border>
        </Border>-->

        <Label Margin="0,7,0,-7" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="3"  HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock TextWrapping="NoWrap" Text="初始值" />
        </Label>

        <Label Margin="0,7,0,-7" Grid.Column="5" Grid.Row="0" Grid.ColumnSpan="5"   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock TextWrapping="NoWrap" Text="反应值" />
        </Label>

        <Label Margin="0,7,0,-7" Grid.Column="11" Grid.Row="0" Grid.ColumnSpan="3"   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock TextWrapping="NoWrap" Text="Δ值" />
        </Label>
        <ItemsControl  Grid.Column="0" Grid.Row="1"  Grid.ColumnSpan="16" Grid.RowSpan="3" Margin="1,3,1,6"  HorizontalAlignment="Center" 
             x:Name="UIZhuiSuC10MM" Background="Transparent">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Vertical" ItemHeight="35"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="0,0,0,0">
                        <StackPanel Width="107" Margin="2,0,1,0" Orientation="Horizontal">
                            <Label  Tag="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" FontSize="18"  Margin="3,1,0,0" BorderThickness="0,0,0,0" BorderBrush="#FF394376" Width="43" Content="{Binding GradeStart, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Foreground="{DynamicResource FontColorStart}" />
                            <Label  Background="{Binding GradeColor, UpdateSourceTrigger=PropertyChanged }" Tag="{Binding Tag, UpdateSourceTrigger=PropertyChanged,Mode=OneWay}"  Width="16" Margin="1,5,1,0" Cursor="Hand" MouseDown="ButtonColorSelect_Click" />
                            <TextBox FontSize="19" Text="{Binding GradeEnd, UpdateSourceTrigger=PropertyChanged,Mode=OneWay, Converter={StaticResource DecimalConverter}}" Tag="{Binding Tag, UpdateSourceTrigger=PropertyChanged }" Margin="0,1,3,0"  BorderThickness="1,1,1,1" BorderBrush="#FF394376" Width="43" Foreground="{DynamicResource FontColorStart}" LostFocus="TextBox_LostFocus" PreviewKeyDown="TextBox_PreviewKeyDown"  />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="4" Grid.Column="0"    Grid.ColumnSpan="5" Margin="6,15,-6,0" Background="#3275fd"
                    x:Name="BtnStart" Click="BtnStart_Click" BorderThickness="0"
                    IsEnabled="{Binding CanBtnStart, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32" Cursor="Hand">
            <TextBlock Text="开始(S)" />
        </Button>

        <Button Grid.Row="4" Grid.Column="5"  Grid.ColumnSpan="5" Margin="12,15,0,0" Background="#3275fd"
                    x:Name="BtnPause" Click="BtnPause_Click" BorderThickness="0" 
                    IsEnabled="{Binding CanBtnPause, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32" Cursor="Hand">
            <TextBlock Text="暂停(P)" />
        </Button>

        <TextBox Grid.Row="4" Grid.Column="10"  Grid.ColumnSpan="5" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.PrefixText=""
                    materialDesign:TextFieldAssist.SuffixText=""  IsReadOnly="True"
                    x:Name="TxtGradingTimePoint" Margin="5,10,0,-5"  FontSize="32" Foreground="Red"
                    Text="{Binding TxtCurrentSpanInt, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" 
                     ToolTip="品质分级时间点，按照某时间点测量值分级"  >
        </TextBox>

        <Slider  Margin="5 0 5 -10" Name="SliderProgress" Height="35"
            Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="16" TickFrequency="10" Orientation="Horizontal" TickPlacement="BottomRight" 
                 Minimum="1" ValueChanged="SliderProgress_ValueChanged"
                 Maximum="{Binding TxtTotalSpan, UpdateSourceTrigger=PropertyChanged}" 
                 Value="{Binding TxtCurrentSpan, UpdateSourceTrigger=PropertyChanged}" />
        
        

    </Grid>
</UserControl>
