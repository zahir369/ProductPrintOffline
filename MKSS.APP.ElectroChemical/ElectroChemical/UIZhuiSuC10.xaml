<UserControl x:Class="MKSS.APP.ElectroChemical.UIZhuiSuC10"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MKSS.APP.ElectroChemical"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="800" d:DesignWidth="1800">

    <UserControl.DataContext>
        <local:UIZhuiSuC10Model/>
    </UserControl.DataContext>
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="43"/>
        </Grid.RowDefinitions>
            
        <Grid x:Name="grid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
            </Grid.RowDefinitions>
            <local:UIZhuiSuC10Chart x:Name="UIZhuiSuC10Chart"  Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,0" BorderThickness="9,9,9,9" BorderBrush="{DynamicResource UIZhuiSuBrush}"/>
            <Border BorderThickness="9,1,1,9" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="1"  
                BorderBrush="{DynamicResource UIZhuiSuBrush}">
                <TabControl TabStripPlacement="Right"  
                
                Margin="0,0,0,0" SelectionChanged="TabControl_SelectionChanged"   
                Style="{StaticResource MaterialDesignNavigatilRailTabControl}" 
                materialDesign:ColorZoneAssist.Mode="Light">
                <TabItem  ToolTip="实时" x:Name="TabItemCurrent"  
                    Header="{materialDesign:PackIcon Kind=ProgressClock, Size=39}"
                    Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                    <local:UIZhuiSuC10Sensors x:Name="UIZhuiSuC10Sensors" />
                </TabItem>
                <TabItem ToolTip="历史" x:Name="TabItemAll"  
                    Header="{materialDesign:PackIcon Kind=ViewComfyOutline, Size=39}"
                    Style="{StaticResource MaterialDesignNavigationRailTabItem}" >
                    <local:UIZhuiSuC10Grid x:Name="UIZhuiSuC10Grid" />
                </TabItem>
                </TabControl>
            </Border>
            <local:UIZhuiSuC10Setting x:Name="UIZhuiSuC10Setting" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="1" Margin="0,0,0,0" BorderThickness="9,1,9,9" BorderBrush="{DynamicResource UIZhuiSuBrush}"/>
        </Grid>

        <Label x:Name="TimeNow" Grid.Row="2" Content="2021-02-02 12:00:00" VerticalAlignment="Center"  Margin="0,0,20,0" HorizontalAlignment="Right" FontSize="15"  FontWeight="Bold"  Foreground="#FF000F59" />

        <ProgressBar Grid.Column="0" Grid.Row="1" Width="50" Height="50" Visibility="Hidden" x:Name="ProgressNow"
                Style="{StaticResource MaterialDesignCircularProgressBar}"
                Value="90" IsIndeterminate="True" />
        
    </Grid>
</UserControl>
