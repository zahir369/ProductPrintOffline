<Window x:Class="DeviceDataMonitorWPF.UIBiaoDing.UIBoardCaseSelect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeviceDataMonitorWPF.UIBiaoDing"  ResizeMode="NoResize"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" Loaded="Window_Loaded"  
        Title="选择老化柜" Height="600" Width="1200">
    <Grid Grid.Row="0" Margin="0,2,0,0" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60*"/>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>
        <ListBox  x:Name="TxtBoardCaseList01" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                        Margin="10,0,10,10" SelectionChanged="TxtBoardCaseSelect_SelectionChanged"  FontSize="12"
                                      Style="{StaticResource MaterialDesignFilterChipAccentListBox}">
            <ListBoxItem Content="01" />
            <ListBoxItem IsSelected="True" Content="02" />
            <ListBoxItem Content="03" />
            <ListBoxItem Content="04" />
            <ListBoxItem Content="05" />
        </ListBox>

        <ListBox  x:Name="TxtBatchCaseSelectFloor" Grid.Row="0" Grid.Column="1"  Grid.RowSpan="2"
                        Margin="10,0,10,5"  FontSize="12"
                        SelectionChanged="TxtBatchCaseSelectFloor_SelectionChanged" 
                        Style="{StaticResource MaterialDesignFilterChipAccentListBox}">
            <ListBoxItem Content="01-01" />

        </ListBox>
    </Grid>
</Window>
