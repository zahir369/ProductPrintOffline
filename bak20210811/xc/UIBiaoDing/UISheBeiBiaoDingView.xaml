<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeviceDataMonitorWPF.UIBiaoDing"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:DeviceDataMonitorWPF="clr-namespace:DeviceDataMonitorWPF" 
             x:Class="DeviceDataMonitorWPF.UIBiaoDing.UISheBeiBiaoDingView"
             mc:Ignorable="d" Foreground="Black" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:s="https://github.com/canton7/Stylet" 
             Unloaded="UserControl_Unloaded" 
             d:DataContext="{d:DesignInstance local:UISheBeiBiaoDingViewModel}"
             d:DesignHeight="1080" d:DesignWidth="1920">
    <UserControl.DataContext>
        <local:UISheBeiBiaoDingViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <SolidColorBrush x:Key="MTextcolorBrush" Color="#FF233177" />
        <Style x:Key="MaterialDesignFloatingHintTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
            <Setter Property="Foreground" Value="#FF233177"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="43"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Grid.RowSpan="3" x:Name="TabControlMain" SelectionChanged="TabControlMain_SelectionChanged"
          Style="{StaticResource MaterialDesignNavigatilRailTabControl}" >
            <TabItem  x:Name="TabItemVoltage"
                Header="{materialDesign:PackIcon Kind=FastForward5, Size=39}"
                Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="100*"/>
                        <RowDefinition Height="39"/>
                    </Grid.RowDefinitions>
                    <local:UISheBeiBiaoDingC05 x:Name="UISheBeiBiaoDingC05" Grid.Row="1" Margin="10,10,10,10"/>
                </Grid>
            </TabItem>
            <TabItem  x:Name="TabItemVoltage10"
                Header="{materialDesign:PackIcon Kind=FastForward10, Size=39}"
                Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="100*"/>
                        <RowDefinition Height="39"/>
                    </Grid.RowDefinitions>
                    <local:UISheBeiBiaoDingC10 x:Name="UISheBeiBiaoDingC10" Grid.Row="1" Margin="10,10,10,10"/>

                </Grid>
            </TabItem>
            <TabItem x:Name="TabItemParamenter"
                Header="{materialDesign:PackIcon Kind=DotsHorizontalCircleOutline, Size=39}"
                Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="100*"/>
                        <RowDefinition Height="39"/>
                    </Grid.RowDefinitions>
                    <local:UISheBeiBiaoDingCQT x:Name="UISheBeiBiaoDingCQT" Grid.Row="1" Margin="10,10,10,10"/>

                </Grid>
            </TabItem>
            <TabItem  x:Name="TabItemBatchList"
                Header="{materialDesign:PackIcon Kind=ChartBarStacked, Size=39}"
                Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="100*"/>
                        <RowDefinition Height="39"/>
                    </Grid.RowDefinitions>
                    <local:UISheBeiBiaoDingCGK x:Name="UISheBeiBiaoDingCGK" Grid.Row="1" Margin="10,10,10,10"/>

                </Grid>
            </TabItem>
        </TabControl>

        <Border 
            Grid.Row="0" BorderThickness="1" BorderBrush="LightGray"  
            materialDesign:ShadowAssist.ShadowDepth="Depth4"
                Margin="83,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230*"/>
                    <ColumnDefinition Width="80*"/>
                    <ColumnDefinition Width="90*"/>
                    <ColumnDefinition Width="45*"/>
                    <ColumnDefinition Width="45*"/>
                    <ColumnDefinition Width="80*"/>
                    <ColumnDefinition Width="80*"/>
                    <ColumnDefinition Width="80*"/>
                    <ColumnDefinition Width="80*"/>
                    <ColumnDefinition Width="80*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*"/>
                    <RowDefinition Height="100*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100*"/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" Grid.Column="0"  Margin="10,5,0,5" x:Name="TxtPortsModeSelect"
                        Style="{StaticResource MaterialDesignChoiceChipListBox}"
                        SelectionChanged="TxtPortsModeSelect_SelectionChanged" >
                        <ListBoxItem IsSelected="True" Content="局域网" />
                        <ListBoxItem Content="串口" />
                        <ListBoxItem Content="老化柜" PreviewMouseUp="ListBoxItem_MouseUp" />
                    </ListBox>
                    <ComboBox  Grid.Row="0" Grid.Column="1"
                        x:Name="TxtSerialPorts" Margin="0,5,10,0"
                        Style="{StaticResource MaterialDesignFilledComboBox}" PreviewMouseUp="TxtSerialPorts_PreviewMouseUp"  
                        Text="{Binding TxtSerialPorts, UpdateSourceTrigger=PropertyChanged}" Visibility="Hidden"
                        IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}" >
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                                <materialDesign:PackIcon Kind="SerialPort" />
                                <TextBlock x:Name="TxtSerialPortsDesc"  Text="{Binding TxtSerialPortsDesc, UpdateSourceTrigger=PropertyChanged}"  FontSize="14" FontWeight="Bold" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                        <ComboBoxItem Content="COM1" />
                        <ComboBoxItem Content="COM2" />
                        <ComboBoxItem Content="COM3" />
                    </ComboBox>
                    <TextBox  Grid.Row="0" Grid.Column="2"
                        x:Name="TxtTCPIP"  Margin="10,5,10,0" 
                        Text="{Binding TxtTCPIP, UpdateSourceTrigger=PropertyChanged}"        
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                        materialDesign:TextFieldAssist.HasClearButton="True" 
                        materialDesign:TextFieldAssist.PrefixText="" 
                        materialDesign:TextFieldAssist.SuffixText="" Cursor="IBeam">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                                <TextBlock Text="IP地址，例如：192.168.100.99:5000" FontSize="10" FontWeight="Bold" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>
                </Grid>


                <ComboBox Grid.Row="1" Grid.Column="0"
                    x:Name="TxtProductList"  Margin="10,0,120,5" SelectionChanged="TxtProductList_SelectionChanged" 
                    Text="{Binding TxtProductList, UpdateSourceTrigger=PropertyChanged}" 
                    DisplayMemberPath="Name"
                    Style="{StaticResource MaterialDesignFilledComboBox}"
                    IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}" >
                    <materialDesign:HintAssist.Hint>
                        <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                            <materialDesign:PackIcon Kind="FormatListBulletedType" />
                            <TextBlock Text="产品型号" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </materialDesign:HintAssist.Hint>
                    <ComboBoxItem Content="COM1" />
                    <ComboBoxItem Content="Item 2" />
                    <ComboBoxItem Content="Item 3" />
                </ComboBox>
                <materialDesign:Badged x:Name="BtnScrwdTip" Grid.Row="1" Grid.Column="0" BadgeColorZoneMode="SecondaryMid" HorizontalAlignment="Right" Margin="10,11,10,5"
                  Badge="{Binding BtnScrwdTipBadge, UpdateSourceTrigger=PropertyChanged}">
                    <Button Width="98"  
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnScrwd}"
                    materialDesign:ButtonAssist.CornerRadius="2" BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnScrwd" Content="  任务单" ToolTip="请选择所属任务单" Background="#FF79B42E" Cursor="Hand"/>
                </materialDesign:Badged>
                
                
                
                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*"/>
                        <RowDefinition Height="100*"/>
                    </Grid.RowDefinitions>
                    <StackPanel   Grid.Row="0" Grid.Column="0"
                      Orientation="Horizontal"
                      Margin="4">
                        <RadioButton
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Margin="4"
                        IsChecked="True"
                        Content="FIRST" />
                        <RadioButton
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Margin="4"
                        IsChecked="False"
                        Content="SECOND" />
                        <RadioButton
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Margin="4"
                        IsChecked="False"
                        IsEnabled="False"
                        Content="THIRD" />
                    </StackPanel>
                    <Button  Grid.Row="1" Grid.Column="0" Margin="10,0,10,5"
                        Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnConnect}"
                        materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0" materialDesign:ShadowAssist.ShadowDepth="Depth1"
                        x:Name="BtnConnect" Content="连接" Background="#FF179698" Cursor="Hand"/>
                </Grid>

                <Button  Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnDisConnect}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnDisConnect" Content="断开" Background="#FFD33F34"  Margin="10,5,10,5" Cursor="Hand"/>

                <Grid Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"  Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100*"/>
                        <RowDefinition Height="100*"/>
                    </Grid.RowDefinitions>
                    <TextBox  Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                    x:Name="TxtValueBase"  Margin="0,5,0,5"  PreviewKeyDown="TxtValueBase_InputNumber" 
                    Text="{Binding TxtValueBase, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="" TextChanged="TxtValueBase_TextChanged" Cursor="IBeam">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                                <TextBlock x:Name="TxtValueBaseDesc" Text="浓度基准值" FontSize="14" FontWeight="Bold" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>
                    <TextBox  Grid.Row="0" Grid.Column="1" FontSize="10"
                    x:Name="TxtValueMinus"  Margin="0,5,0,0"  PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding TxtValueMinus, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:TextFieldAssist.PrefixText="-" 
                    materialDesign:TextFieldAssist.SuffixText="" >
                    </TextBox>
                    <TextBox  Grid.Row="1" Grid.Column="1" FontSize="10"
                    x:Name="TxtValueAdd"  Margin="0,0,0,5"  PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding TxtValueAdd, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:TextFieldAssist.PrefixText="+" 
                    materialDesign:TextFieldAssist.SuffixText="">
                    </TextBox>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="2" Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100*"/>
                        <RowDefinition Height="100*"/>
                    </Grid.RowDefinitions>
                    <TextBox  Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                    x:Name="TxtVoltageValueBase"  Margin="0,0,0,5"  PreviewKeyDown="TxtVoltageValueBase_InputNumber"
                    Text="{Binding TxtVoltageValueBase, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="" Height="44" VerticalAlignment="Bottom" TextChanged="TxtVoltageValueBase_TextChanged">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                                <TextBlock x:Name="TxtVoltageValueBaseDesc" Text="信号AD基准值" FontSize="14" FontWeight="Bold" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>
                    <TextBox  Grid.Row="0" Grid.Column="1" FontSize="10"
                    x:Name="TxtVoltageValueMinus"  Margin="0,5,0,0"  PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding TxtVoltageValueMinus, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:TextFieldAssist.PrefixText="-" 
                    materialDesign:TextFieldAssist.SuffixText="" >
                    </TextBox>
                    <TextBox  Grid.Row="1" Grid.Column="1" FontSize="10"
                    x:Name="TxtVoltageValueAdd"  Margin="0,0,0,5"  PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding TxtVoltageValueAdd, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:TextFieldAssist.PrefixText="+" 
                    materialDesign:TextFieldAssist.SuffixText="">
                    </TextBox>
                </Grid>

                <TextBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3"
                    x:Name="TxtSensorGrougAddress"  Margin="10,5,10,5" PreviewKeyDown="TxtSensorGrougAddress_PreviewKeyDown"
                    Text="{Binding TxtSensorGrougAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.HasClearButton="True" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="">
                    <materialDesign:HintAssist.Hint>
                        <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                            <!--<materialDesign:PackIcon Kind="AccessPoint" />-->
                            <TextBlock x:Name="TxtSensorGrougAddressDesc" Foreground="#FF188C8E" FontSize="14" FontWeight="Bold" Text="{Binding TxtSensorGrougAddressDesc, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </materialDesign:HintAssist.Hint>
                </TextBox>

                <Button Grid.Row="0" Grid.Column="5" 
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnQuery}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnQuery" Content="{Binding BtnQueryText}" Background="{Binding BtnQueryBackground}"  Margin="10,5,10,5" Cursor="Hand"/>
                <Button Grid.Row="1" Grid.Column="5" 
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnQueryParameter}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0" materialDesign:ShadowAssist.ShadowDepth="Depth1"
                    x:Name="BtnQueryParameter" Content="{Binding BtnQueryParameterText}" Background="{Binding BtnQueryParameterBackground}"  Margin="10,5,10,5"/>

                <materialDesign:PopupBox  Grid.Row="1" Grid.Column="5" HorizontalAlignment="Right"
                    StaysOpen="True" x:Name="PopupBoxQueryParameter"
                    IsEnabled="{Binding IsChecked, ElementName=PopupEnabled}">
                    <StackPanel 
                            Orientation="Vertical"
                            HorizontalAlignment="Right">
                        <Button x:Name="BtnReadSerialNo" s:View.ActionTarget="{Binding}" Command="{s:Action BtnReadSerialNo}"
                              Content="读取序列号"  ToolTip="读取序列号" />
                        <Button x:Name="BtnReadTime" s:View.ActionTarget="{Binding}" Command="{s:Action BtnReadTime}" 
                              Content="读取设备时间" ToolTip="读取传感器时间、传感器出厂日期" ></Button>
                        <Button x:Name="BtnSetSerialNo" s:View.ActionTarget="{Binding}" Command="{s:Action BtnSetSerialNo}"
                              Content="生成序列号"  ToolTip="写入序列号" />
                        <Button x:Name="BtnSetTime" s:View.ActionTarget="{Binding}" Command="{s:Action BtnSetTime}" 
                              Content="登记设备时间" ToolTip="写入传感器时间、传感器出厂日期" >
                        </Button>
                    </StackPanel>
                </materialDesign:PopupBox>
                
                <Button Grid.Row="0" Grid.Column="6" 
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnModeSelfReport}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0" materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnModeSelfReport" Content="主动模式" Background="#FF366BC3"  Margin="10,5,10,5" Cursor="Hand"/>
                <Button Grid.Row="1" Grid.Column="6" 
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnModeQuery}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnModeQuery" Content="问询模式" Background="#FF358CD4"  Margin="10,5,10,5" />

                <TextBox  Grid.Row="0" Grid.Column="7"  
                    x:Name="TxtZreo"  Margin="10,5,10,5" PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding TxtZreo, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.HasClearButton="True" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="" >
                    <materialDesign:HintAssist.Hint>
                        <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                            <TextBlock Text="零点" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </materialDesign:HintAssist.Hint>
                </TextBox>
                <Button  Grid.Row="0" Grid.Column="8" 
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnSetZero}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnSetZero" Content="标定零点" Background="#FF366BC3"  Margin="10,5,10,5"/>
                <TextBox  Grid.Row="1" Grid.Column="7"  
                    x:Name="TxtSpan" Margin="10,5,10,5" PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding TxtSpan, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.HasClearButton="True" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="" >
                    <materialDesign:HintAssist.Hint>
                        <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                            <TextBlock Text="SPAN点" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </materialDesign:HintAssist.Hint>
                </TextBox>
                <Button Grid.Row="1" Grid.Column="8"  
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnSetSpan}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnSetSpan" Content="标定SPAN点" Background="#FF358CD4"  Margin="10,5,10,5"/>
                <Button Grid.Row="0" Grid.Column="9"  
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnJudge}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnJudge" Content="判定合格" Background="#FF17986F"  Margin="10,5,10,5"/>
                <Button Grid.Row="1" Grid.Column="9"  
                    Style="{StaticResource MaterialDesignRaisedButton}" s:View.ActionTarget="{Binding}" Command="{s:Action BtnExport}"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnExport" Content="导出结果" Background="#FF0029FF"  Margin="10,5,10,5"/>
                <materialDesign:PopupBox Grid.Row="1" Grid.Column="9" HorizontalAlignment="Right"
                    StaysOpen="True"
                    IsEnabled="{Binding IsChecked, ElementName=PopupEnabled}">
                    <StackPanel 
                            Orientation="Vertical"
                            HorizontalAlignment="Right">
                        <Button
                              Content="导出标定成果（默认）"  ToolTip="导出所有传感器的标定成果"
                               s:View.ActionTarget="{Binding}" Command="{s:Action BtnExport}" />
                        <Button 
                              Content="导出历史数据" ToolTip="若要导出实时AD、浓度历史数据，可双击数据打开曲线图后在右上角点“导出”按钮导出。"
                               s:View.ActionTarget="{Binding}" >
                        </Button>
                    </StackPanel>
                </materialDesign:PopupBox>

            </Grid>
        </Border>
        <Border  Grid.Row="2" BorderThickness="1" BorderBrush="LightGray">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Left" 
                        FlowDirection="RightToLeft" Margin="0,4" >
                <CheckBox x:Name="StaReadSerialNo" Content="读取串号" 
                          IsChecked="{Binding StaReadSerialNo, UpdateSourceTrigger=PropertyChanged}"
                             />
                <CheckBox x:Name="StaFilterEmpSata" Content="滤波" 
                          IsChecked="{Binding StaFilterEmpSata, UpdateSourceTrigger=PropertyChanged}"
                             />
                <CheckBox x:Name="StaZeroSpanTitleExchange"  IsChecked="{Binding StaZeroSpanTitleExchange, UpdateSourceTrigger=PropertyChanged}"
                          Unchecked="StaZeroSpanTitleExchange_Checked"  
                          Content="名称对调" Width="83" Checked="StaZeroSpanTitleExchange_Checked" />
                <TextBlock x:Name="StaTimeElapsed" FontWeight="Bold" VerticalAlignment="Center" 
                           TextWrapping="Wrap" Text="{Binding StaTimeElapsed, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Width="69" Foreground="#FF000F59"  />
                <Label Content="历时" Foreground="#FF000F59" />
                <TextBlock x:Name="StaRate" VerticalAlignment="Center" 
                           Text="{Binding StaRate, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                            FontWeight="Bold" FlowDirection="LeftToRight" Width="80" Foreground="#FF17986F" />
                <Label Content="合格率" Foreground="#FF000F59" Width="60" />
                <TextBlock x:Name="StaUnqualified"  FontWeight="Bold" VerticalAlignment="Center"
                            Text="{Binding StaUnqualified, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                           Width="60" Foreground="#FFD45046" />
                <Label Content="不良品/个" Canvas.Bottom="5" Width="67" Foreground="#FF000F59" />
                <TextBlock x:Name="StaQuallified"  FontWeight="Bold" VerticalAlignment="Center"
                            Text="{Binding StaQuallified, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                            Width="60" Foreground="#FF17986F" />
                <Label Content="合格/个"  Width="61" Foreground="#FF000F59" />
                <TextBlock x:Name="StaTotal"  FontWeight="Bold" VerticalAlignment="Center"
                            Text="{Binding StaTotal, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                             Width="60" Foreground="#FF000F59" />
                <Label Content="总数/个" Width="63" Foreground="#FF000F59" />

                <TextBlock x:Name="StaSelectedAverage"  FontWeight="Bold" VerticalAlignment="Center"
                            Text="{Binding StaSelectedAverage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                             Width="60" Foreground="#FF000F59" />
                <Label Content="平均值" Width="63" Foreground="#FF000F59" />
                
                <TextBlock x:Name="StaSelectedCount"  FontWeight="Bold" VerticalAlignment="Center"
                            Text="{Binding StaSelectedCount, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                             Width="60" Foreground="#FF000F59" />
                <Label Content="选中/个" Width="63" Foreground="#FF000F59" />
                
                <Label x:Name="LabelMessage" FlowDirection="LeftToRight" Content="{Binding LabelMessage, UpdateSourceTrigger=PropertyChanged}" Width="844" Foreground="#FF000F59" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
