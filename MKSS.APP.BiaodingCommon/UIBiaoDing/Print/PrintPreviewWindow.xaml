<Window x:Class="MKSS.APP.UIBiaoDing.Print.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="打印预览窗口" Height="350" Width="800"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions >
            <ColumnDefinition Width="20*"></ColumnDefinition>
            <ColumnDefinition Width="80*"></ColumnDefinition>
            <ColumnDefinition Width="20*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="30*"></RowDefinition>
            <RowDefinition Height="20*"></RowDefinition>
        </Grid.RowDefinitions>
        <Image x:Name="PreviewImage" Grid.Column="1" Grid.Row="1" />
        <Label x:Name="PageInfo" Content="当前第130/600页" Grid.Column="0" HorizontalAlignment="Right"  Margin="0,5,500,0" Grid.Row="2"  Grid.ColumnSpan="3" VerticalAlignment="Center"/>

        <Button x:Name="PrePage" Click="PrePage_Click" Width="32" Height="32" HorizontalAlignment="Right"  Grid.Column="0" Grid.Row="2"  Grid.ColumnSpan="3" Margin="0,22,630,13" VerticalAlignment="Center"
                  Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                  ToolTip="前一页">
            <materialDesign:PackIcon
                    Kind="SkipPrevious"
                    Height="21"
                    Width="21" />
        </Button>
        <Button x:Name="NextPage" Click="NextPage_Click" Width="32" Height="32" HorizontalAlignment="Right" Grid.Column="0" Grid.Row="2"  Grid.ColumnSpan="3" Margin="0,22,450,13" VerticalAlignment="Center"
                  Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                  ToolTip="后一页">
            <materialDesign:PackIcon
                    Kind="SkipNext"
                    Height="21"
                    Width="21" />
        </Button>
        <Button x:Name="PrintSinglePage" Click="PrintSinglePage_Click" Content="打印单张" HorizontalAlignment="Right" Width="120" Grid.Column="1" Grid.Row="2"  Grid.ColumnSpan="3" Margin="0,22,290,13" />
        <Button x:Name="PrintAllPage" Click="PrintAllPage_Click" Content="打印全部" HorizontalAlignment="Right" Width="120" Grid.Column="1" Grid.Row="2"  Grid.ColumnSpan="3" Margin="0,22,150,13" />
        <Button  x:Name="Cancel" Click="Cancel_Click" Content="取消"  Width="120" HorizontalAlignment="Right" Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,22,30,13" />
        <ComboBox  x:Name="printer_comboBox" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,0,30,0" VerticalAlignment="Top" Width="246"/>

    </Grid>
</Window>
