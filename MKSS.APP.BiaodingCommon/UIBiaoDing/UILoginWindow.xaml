<Window x:Class="MKSS.APP.BiaodingAlcohol.UIBiaoDing.UILoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:MKSS.APP.BiaodingAlcohol.UIBiaoDing"
        mc:Ignorable="d"
        Title="UILoginWindow" Height="300" Width="320">
    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="10">
            <DockPanel Grid.Row="0" Height="40" Margin="10">
                <Label Content="用户名：" FontSize="20"/>
                <TextBox
                                x:Name="TxtUser"  
                                 FontSize="20" Foreground="Black" Text=""    Cursor="IBeam" >
                </TextBox>
            </DockPanel>
            <DockPanel Grid.Row="1" Height="40" Margin="10">
                <Label Content="密码：" FontSize="20"/>
                <TextBox  
                                x:Name="TxtPsw"  
                                 FontSize="20" Foreground="Black"  Text=""   Cursor="IBeam" >
                </TextBox>
            </DockPanel>
            <Button  Grid.Row="2" Margin="10"
                                x:Name="TxtUserLogout" ToolTip="登录" FontSize="16" Foreground="White" Content="登录"     Cursor="IBeam" Click="TxtUserLogout_Click" >
            </Button>
        </StackPanel>
       
    </Grid>
</Window>
