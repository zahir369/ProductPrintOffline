<Window x:Class="MKSS.APP.UIBiaoDing.UIScrwSelect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MKSS.APP.UIBiaoDing"  ResizeMode="NoResize"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" Loaded="Window_Loaded"
        Title="选择所属生产任务" Height="600" Width="1200">
    <Window.Resources>
        <ResourceDictionary>
            <local:DataColorConverter x:Key="DataColorConverterStyle"/>
            <Style TargetType="DataGrid" >
                <Setter Property="BorderBrush" Value="#FFF5F7F5" />
                <Setter Property="HorizontalGridLinesBrush">
                    <Setter.Value>
                        <SolidColorBrush Color="#d6c79b"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="VerticalGridLinesBrush">
                    <Setter.Value>
                        <SolidColorBrush Color="#d6c79b"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="DataGridColumnHeader" >
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Background" Value="{DynamicResource UIBiaoDingBrush}"/>
                <Setter Property="Foreground" Value="#FF000000"/>
                <Setter Property="Height" Value="28"/>
            </Style>
            <Style x:Key="HyperlinkStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="Blue" />
                <Setter Property="TextDecorations" Value="Underline" />
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="32*" />
            <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="32*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <ListBox  Grid.Row="0" Grid.Column="0"
                  x:Name="depName" Margin="10,0,10,0" SelectionMode="Single"
                  SelectionChanged="monthList_SelectionChanged"
              Style="{StaticResource MaterialDesignFilterChipListBox}">
            <ListBoxItem
                IsSelected="True"
                Content="电子" />
            <ListBoxItem
                Content="电化学" />
            <ListBoxItem
                Content="半导体" />
        </ListBox>
        <ToggleButton Grid.Row="0" Grid.Column="1" x:Name="isFinished"
            Style="{StaticResource MaterialDesignSwitchLightToggleButton}"
            ToolTip="是否完工" Click="ToggleButton_Click"
            IsChecked="False" />
        <ComboBox  Grid.Row="0" Grid.Column="2"  Foreground="Red" 
              materialDesign:HintAssist.Hint="任务月份"
              materialDesign:HintAssist.FloatingScale="1.5"
              materialDesign:HintAssist.FloatingOffset="0, -24"
              MinWidth="72" x:Name="monthList" SelectionChanged="monthList_SelectionChanged" >
             
        </ComboBox>
        <Button Width="98" Grid.Row="2" Grid.Column="4"  HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignRaisedButton}"  Margin="10,5,20,5" 
                    materialDesign:ButtonAssist.CornerRadius="2" BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1"
                     x:Name="BtnScrwd" Content="确定" ToolTip="确定请选择所属任务单" Background="#FF79B42E" Cursor="Hand" Click="BtnScrwd_Click"/>
        <Border  BorderBrush="{DynamicResource UIBiaoDingBrush}" Margin="10,10,10,10"
                 Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" BorderThickness="10">

            <DataGrid x:Name="dataGrid" SelectionUnit="FullRow" SelectionMode="Single" MouseDoubleClick="OpenBatch_MouseLeftButtonUp" 
                      ItemsSource="{Binding}" IsReadOnly="True" AutoGenerateColumns="False"  RowHeaderWidth="0" >

                <DataGrid.CellStyle>
                    <Style TargetType = "{x:Type DataGridCell}" >
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns> 
                    <DataGridTextColumn Header="任务单号" Width="15*" Binding="{Binding OrderNumber}"/>
                    <DataGridTextColumn Header="型号" Width="10*" Binding="{Binding ProductCode}"/>
                    <DataGridTextColumn Header="型号名称" Width="30*" Binding="{Binding ProductFullName}"/>
                    <DataGridTextColumn Header="类别" Width="15*" Binding="{Binding ProductType}"/>
                    <DataGridTextColumn Header="数量" Width="6*" Binding="{Binding Qty}"/>
                    <DataGridTextColumn Header="已完成" Width="5*" Binding="{Binding ToQty}"/>
                    <DataGridTextColumn Header="部门" Width="6*" Binding="{Binding Department}"/>
                    <DataGridTextColumn Header="日期" Width="7*" Binding="{Binding Date}"/>
                     
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
