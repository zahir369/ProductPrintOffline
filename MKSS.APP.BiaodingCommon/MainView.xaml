<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:UIBiaoDing="clr-namespace:MKSS.APP.UIBiaoDing"
    x:Class="MKSS.APP.UIBiaoDing.MainView" 
    xmlns:local="clr-namespace:MKSS.APP.UIBiaoDing" 
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:MainViewModel}"
    Title="郑州美克盛世电子科技有限公司"
    Width="800"
    Height="450" 
    Background="{DynamicResource MaterialDesignPaper}"
    TextElement.FontSize="14"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal" 
    TextOptions.TextRenderingMode="Auto" WindowState="Maximized"
    WindowStartupLocation="CenterScreen"   >
    <Viewbox Stretch="Fill">
        <Grid Width="1920" Height="1080" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="674" />
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="119" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <materialDesign:ColorZone
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Padding="8" Height="120"
            VerticalAlignment="Center" Background="{DynamicResource PrimaryHueLightBrush}"
            Mode="PrimaryDark">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="100*"/>
                        <ColumnDefinition Width="30*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30*"></RowDefinition>
                        <RowDefinition Height="100*"></RowDefinition>
                        <RowDefinition Height="50*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Image x:Name="MainLogo" Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                        Width="250"
                        Height="80"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="/Resources/Images/logo5.png" />
                    <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="3">
                        <TextBlock x:Name="MainSubTile"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="36"
                            FontWeight="Bold"
                            Text="智慧工厂生产数字化管理系统-标定软件" />
                        <TextBlock x:Name="MainSubVersion"
                            Margin="16,10,0,0"
                            VerticalAlignment="Center"
                            FontSize="30"
                            FontWeight="Bold"
                            Text="V3.8" />
                        <TextBlock x:Name="MainOnline"
                            Margin="16,10,0,0"
                            VerticalAlignment="Center"
                            FontSize="30"
                            FontWeight="Bold"
                            Text="" />
                        <ToggleButton Margin="0,10,0,2" x:Name="RunModeOnline" Checked="RunModeOnline_Checked" Unchecked="RunModeOnline_Checked"
                            Style="{StaticResource MaterialDesignActionToggleButton}"
                            ToolTip="开发版本地临时存储标定数据；正式版在服务器上永久存储标定数据"
                            Content="{materialDesign:PackIcon Kind=AccessPointNetworkOff}"
                            materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=AccessPointNetwork}" />

                    </StackPanel>
                    <Grid Grid.Row="2" Grid.Column="1"  Grid.ColumnSpan="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*"/>
                            <ColumnDefinition Width="10*"/>
                            <ColumnDefinition Width="10*"/>
                            <ColumnDefinition Width="10*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions> 
                            <RowDefinition Height="100*"></RowDefinition> 
                        </Grid.RowDefinitions>
                        <Button  Grid.Column="3"
                                x:Name="TxtUserLogout"
                                ToolTip="登录状态" FontSize="16" Foreground="White"   Content="登录"
                                materialDesign:TextFieldAssist.SuffixText="" Cursor="IBeam" Click="TxtUserLogout_Click">
                        </Button>
                        <TextBox  Grid.Column="2"
                                x:Name="TxtUserAdmin"
                                ToolTip="核验人" FontSize="16" Foreground="White"   Text="***"
                                materialDesign:TextFieldAssist.PrefixText="核验人" 
                                materialDesign:TextFieldAssist.SuffixText="" Cursor="IBeam">
                        </TextBox>
                        <TextBox  Grid.Column="1"
                                x:Name="TxtUser"  FlowDirection="LeftToRight"
                                ToolTip="操作人" FontSize="16" Foreground="White"  Text="***"
                                materialDesign:TextFieldAssist.PrefixText="操作人" 
                                materialDesign:TextFieldAssist.SuffixText="" Cursor="IBeam">
                        </TextBox>
                        <TextBlock x:Name="ScrwdInfo" Grid.Column="0" Margin="50,5,10,0"
                                FontSize="16" Foreground="LightBlue" HorizontalAlignment="Right"
                                Text="" />
                    </Grid>
                </Grid> 
            </materialDesign:ColorZone>
 
            <materialDesign:DrawerHost
            x:Name="dhDrawerHost"
            Grid.Row="1"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="0"
            OpenMode="Standard" Grid.ColumnSpan="2">
                <UIBiaoDing:UISheBeiBiaoDingView/>
            </materialDesign:DrawerHost>
            
        </Grid>
    </Viewbox>
</Window>
