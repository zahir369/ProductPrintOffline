<Window x:Class="MKSS.APP.ECTester.Print.PrintTemplateDefine"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:MKSS.APP.ECTester.Print"
        mc:Ignorable="d" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Title="设置工业传感器打印模板" Height="250" Width="600">
    <TabControl TabStripPlacement="TOp" >
        <TabItem Header="打印模板" Name="TabItemSingle">
            <Viewbox>
                <Grid Width="600">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32*" />
                        <ColumnDefinition Width="32*" />
                        <ColumnDefinition Width="16*" />
                        <ColumnDefinition Width="16*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32*" />
                        <RowDefinition Height="32*" />
                        <RowDefinition Height="32*" />
                    </Grid.RowDefinitions>
                    <Image
                            Width="600"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="2"
                            Height="137" Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="/Resources/Images/facBg.png" />
                    <TextBox x:Name="PrintTemplateCotent"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="2"
                        VerticalAlignment="Top"
                        Height="137" FontSize="21.7" FontFamily="等线" FontWeight="Bold"
                        AcceptsReturn="True" TextAlignment="Left"
                        TextWrapping="Wrap" Padding="243,20,0,0"
                        VerticalScrollBarVisibility="Auto" Text="Ethylene Oxide
                             MIX8418-ETO-100
                             {灵敏度}
                             M1H12S00H24"
                        IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignOutlinedTextBoxEnabledComboBox}" />
                    <CheckBox
                        x:Name="IndustryModeLabelSmall"
                        IsThreeState="False" 
                        IsChecked="False"  Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"
                        Content="打印小标签（尺寸：5mm*15mm）" />
                    <Grid  Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="1"  Margin="20,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*"/>
                            <ColumnDefinition Width="50*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100*"/>
                            <RowDefinition Height="100*"/>
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Grid.RowSpan="2">位置偏移：</TextBlock>
                        <TextBox  Grid.Row="0" Grid.Column="1" FontSize="10"
                            x:Name="IndustryModeLabelXmm"  Margin="0,5,0,0"  PreviewKeyDown="Txt_InputNumber"
                            Text="+13"
                            materialDesign:TextFieldAssist.PrefixText="X:" 
                            materialDesign:TextFieldAssist.SuffixText="毫米" >
                        </TextBox>
                        <TextBox  Grid.Row="1" Grid.Column="1" FontSize="10"
                            x:Name="IndustryModeLabelYmm"  Margin="0,0,0,5"  PreviewKeyDown="Txt_InputNumber"
                            Text="-11"
                            materialDesign:TextFieldAssist.PrefixText="Y:" 
                            materialDesign:TextFieldAssist.SuffixText="毫米">
                        </TextBox>
                    </Grid>

                    <Button Grid.Column="2" Grid.Row="2" 
                        Style="{StaticResource MaterialDesignRaisedButton}"  Margin="-10,3,2,0" Click="btnPrintPreview_Click"
                        materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0" materialDesign:ShadowAssist.ShadowDepth="Depth1"
                        x:Name="BtnTmpPrint" Content="打印测试页" Background="#FF358CD4" />
                    <Button Grid.Column="3" Grid.Row="2" 
                        Style="{StaticResource MaterialDesignRaisedButton}"  Margin="0,3,10,0" Click="BtnTmpSave_Click"
                        materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0" materialDesign:ShadowAssist.ShadowDepth="Depth1"
                        x:Name="BtnTmpSave" Content="保存" Background="#FF358CD4" />

                </Grid>
            </Viewbox>
        </TabItem> 
    </TabControl>
   
</Window>
