<Window x:Class="MKSS.APP.ECTester.Print.PrintSelect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:MKSS.APP.ECTester.Print"
        mc:Ignorable="d" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Title="打印选项" Height="120" Width="300">
    <TabControl TabStripPlacement="TOp" >
        <TabItem Header="打印选项" Name="TabItemSingle">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="16*" />
                    <ColumnDefinition Width="16*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32*" />
                    <RowDefinition Height="32*" />
                </Grid.RowDefinitions>

                <Grid  Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="4"  Margin="20,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100*"/>
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Grid.RowSpan="2">打印张数：</TextBlock>
                    <TextBox  Grid.Row="0" Grid.Column="1"  VerticalAlignment="Center"
                            x:Name="PrintLabelCount"   
                            Text="64"
                            materialDesign:TextFieldAssist.PrefixText="前：" 
                            materialDesign:TextFieldAssist.SuffixText="张" >
                    </TextBox> 
 
                </Grid>

                <Button Grid.Column="3" Grid.Row="1" 
                        Style="{StaticResource MaterialDesignRaisedButton}"  Margin="-10,3,2,0" Click="btnPrintPreview_Click"
                        materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0" materialDesign:ShadowAssist.ShadowDepth="Depth1"
                        x:Name="BtnTmpPrint" Content="打印" Background="#FF358CD4" /> 

            </Grid>
        </TabItem> 
    </TabControl>
   
</Window>
