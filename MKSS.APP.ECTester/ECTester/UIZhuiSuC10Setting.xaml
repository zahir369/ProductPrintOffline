<UserControl x:Class="MKSS.APP.ECTester.UIZhuiSuC10Setting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MKSS.APP.ECTester" Loaded="UserControl_Loaded"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"  d:DesignHeight="600" d:DesignWidth="800" >
    <UserControl.DataContext>
        <local:UIZhuiSuC10SettingModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <local:NullableDecimalConverter x:Key="DecimalConverter"/>
    </UserControl.Resources>
    <Grid Margin="10,30,20,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/> 
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/> 
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>


            <Label x:Name="RefreshProgressText" Height="32" 
               HorizontalAlignment="Left" Content="00:00:00" FontSize="21"  Grid.Column="0" Grid.Row="0" 
               Margin="0,1,0,0" BorderThickness="0,0,0,0" BorderBrush="#FF394376"  VerticalContentAlignment="Center"
               Foreground="{DynamicResource FontColorStart}" />
            <Label x:Name="FullQueryTimesText" Height="32"   
               HorizontalAlignment="Left" Content="No.0000000" FontSize="21"  Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2"  
               Margin="-10,1,28,0" BorderThickness="0,0,0,0" BorderBrush="#FF394376"  VerticalContentAlignment="Center"
               Foreground="{DynamicResource FontColorStart}" />
            
            <Button Grid.Column="2" Margin="0,0,10,0" Background="#FF112B61" BorderThickness="0"
                    x:Name="BtnExcelExport" Click="BtnExcelExport_Click"   HorizontalAlignment="Right" Width="106"
                    IsEnabled="{Binding CanBtnExcelExport, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32"    
                    ToolTip="" Cursor="Hand">
                <TextBlock Text="导出(E)" />
            </Button>

            <ProgressBar HorizontalAlignment="Right" Value="100"  VerticalAlignment="Top" Visibility="Hidden"
              x:Name="RefreshProgress" Grid.Column="2" Grid.Row="0" Width="16" Grid.RowSpan="2"  
              Style="{StaticResource MaterialDesignCircularProgressBar}" />

            <TextBox 
                    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="1" Margin="3,5,3,5"
                    x:Name="TxtSensorGrougAddress" 
                    Text="{Binding TxtSensorGrougAddress, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding CanTxtSensorGrougAddress, UpdateSourceTrigger=PropertyChanged}" 
                    ToolTip="通道地址" 
                    materialDesign:TextFieldAssist.PrefixText="通道地址：" 
                    materialDesign:TextFieldAssist.SuffixText=" " Cursor="IBeam">
            </TextBox>
            
            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="1" Margin="3,2,0,2" 
                    materialDesign:TextFieldAssist.PrefixText="型　　号："
                    materialDesign:HintAssist.Hint="Search" 
                    materialDesign:HintAssist.HintOpacity=".26"
                    x:Name="TxtProductList" SelectionChanged="TxtProductList_SelectionChanged" 
                    Text="{Binding TxtProductList, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding CanTxtProductList, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                    DisplayMemberPath="Name" >
            </ComboBox>
            <ComboBox Grid.Row="2" Grid.Column="2"
                    materialDesign:TextFieldAssist.PrefixText="规　　格："  
                    x:Name="TxtModelList" Margin="3,2,5,2" SelectionChanged="TxtModelList_SelectionChanged" 
                    Text="{Binding TxtModelList, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding CanTxtModelList, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                    DisplayMemberPath="Name" >
            </ComboBox>
            <Button Grid.Row="2" Grid.Column="2" Margin="10,2,15,2" HorizontalAlignment="Right" 
                    Style="{StaticResource  MaterialDesignFlatAccentBgButton}" ToolTip="新增规格" Click="Button_Click" Width="10" Height="10">
                <materialDesign:PackIcon Kind="PlusThick" Height="10" Width="10" />
            </Button>
            
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5*"/> 
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*"/> 
                </Grid.RowDefinitions>


                <ComboBox  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Margin="0,-0,0,-2"
                    x:Name="TxtSerialPorts"  
                    materialDesign:TextFieldAssist.PrefixText="串　　口："  PreviewMouseUp="TxtSerialPorts_PreviewMouseUp" 
                    Text="{Binding TxtSerialPorts, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding CanTxtSerialPorts, UpdateSourceTrigger=PropertyChanged}" >
                    <ComboBoxItem Content="COM1" />
                    <ComboBoxItem Content="COM2" />
                    <ComboBoxItem Content="COM3" />
                </ComboBox>

                <TextBox 
                    Grid.Row="0" Grid.Column="1" Margin="3,2,0,2" Grid.ColumnSpan="1"
                    x:Name="TxtTotalSpan" TextChanged="TxtTotalSpan_TextChanged" 
                    Text="{Binding TxtTotalSpan, UpdateSourceTrigger=PropertyChanged}" 
                    IsEnabled="{Binding CanTxtTotalSpan, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="测试总时长,秒钟"
                    materialDesign:TextFieldAssist.PrefixText="测试时长：" 
                    materialDesign:TextFieldAssist.SuffixText="秒" Cursor="IBeam">
                </TextBox>

                <TextBox  Grid.Row="0" Grid.Column="2"  
                    Margin="3,2,5,2"  Grid.ColumnSpan="1"
                    x:Name="TxtGradingTimePoint" PreviewKeyDown="Txt_InputNumber"
                    Text="{Binding TxtGradingTimePoint, UpdateSourceTrigger=PropertyChanged}" 
                    IsEnabled="{Binding CanBtnStart, UpdateSourceTrigger=PropertyChanged}" 
                    ToolTip="Vs时间，筛选时间"
                    materialDesign:TextFieldAssist.PrefixText="Vs时间：" 
                    materialDesign:TextFieldAssist.SuffixText="秒" Cursor="IBeam" >
                </TextBox>
                
            </Grid>


            <TextBox 
                    Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="1" Margin="3,5,3,5"
                    x:Name="TxtContainerPPM" 
                    Text="{Binding TxtContainerPPM, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding CanContainerPPM, UpdateSourceTrigger=PropertyChanged}" 
                    ToolTip="气体浓度" 
                    materialDesign:TextFieldAssist.PrefixText="气体浓度：" 
                    materialDesign:TextFieldAssist.SuffixText="PPM" Cursor="IBeam">
            </TextBox>
            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                    materialDesign:TextFieldAssist.PrefixText="采样时间："
                    materialDesign:TextFieldAssist.SuffixText="秒" 
                    x:Name="TxtTestTimePoints" Margin="0,5,5,5" TextChanged="TxtTestTimePoints_TextChanged" 
                    Text="{Binding TxtTestTimePoints, UpdateSourceTrigger=PropertyChanged}" 
                    IsEnabled="{Binding CanTxtTestTimePoints, UpdateSourceTrigger=PropertyChanged}" ToolTip="最多10个，包含零点时间（T90时间时间）和反应时间（O₂浓度）"  >

            </TextBox>


        </Grid>


        <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="100*"/> 
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/> 
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="100*"/>
            </Grid.RowDefinitions>
            <!--<Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="15" Grid.RowSpan="4" BorderThickness="2,2,2,2" BorderBrush="{DynamicResource BgColorBBoard}">
                <Border  Margin="10,0,0,0" Width="110" HorizontalAlignment="Center" BorderThickness="2,0,2,0" BorderBrush="{DynamicResource BgColorBBoard}">

                </Border>
            </Border>-->

            <Label Margin="0,0,0,-7" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock TextWrapping="NoWrap" x:Name="SrcTitle" Text="    挡位设置" FontSize="16" FontWeight="Bold" />
            </Label>

            <StackPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Label Margin="0,0,0,-7" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock TextWrapping="NoWrap" x:Name="SrcTitle1" Text="暂停色设置" FontSize="16" FontWeight="Bold" />
                </Label>
                <TextBox x:Name="BtnPauseFrom" LostFocus="BtnPauseFrom_LostFocus" Height="32" Width="70" Margin="0,0,0,0" BorderThickness="1,1,1,1" FontSize="16" BorderBrush="#FF999396" Foreground="{DynamicResource FontColorStart}" VerticalAlignment="Center" HorizontalContentAlignment="Right" Text="-0.06" />
                <Label x:Name="BtnPauseColor" MouseDown="BtnPauseColor_MouseDown" ToolTip="设置范围内颜色" Height="32" Width="35" Margin="0,0,0,0" Background="Yellow"  Cursor="Hand" VerticalAlignment="Center"/>
                <Label x:Name="BtnPauseExceptColor" MouseDown="BtnPauseExceptColor_MouseDown" ToolTip="设置范围外颜色" Height="32" Width="35" Margin="0,0,0,0" Background="Red"  Cursor="Hand" VerticalAlignment="Center"/>
                <TextBox x:Name="BtnPauseTo" LostFocus="BtnPauseTo_LostFocus" Height="32" Width="70" Margin="0,0,0,0" BorderThickness="1,1,1,1" FontSize="16" BorderBrush="#FF999396" Foreground="{DynamicResource FontColorStart}" VerticalAlignment="Center" Text="0.06" />
                <CheckBox x:Name="BtnPauseEnabled" Click="BtnPauseEnabled_Click" FontSize="16" Foreground="{DynamicResource FontColorStart}" VerticalAlignment="Center" Content="启用"/>
            </StackPanel>
            
            <Label Margin="0,0,0,-7" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock TextWrapping="NoWrap" Text="最小" />
            </Label>

            <Label Margin="0,0,0,-7" Grid.Column="0" Grid.Row="2"    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock TextWrapping="NoWrap" Text="颜色" />
            </Label>

            <Label Margin="0,0,0,-7" Grid.Column="0" Grid.Row="3"    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock TextWrapping="NoWrap" Text="最大" />
            </Label>

            <ItemsControl  Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Margin="1,3,1,6" Height="100"  HorizontalAlignment="Left" 
                x:Name="UIZhuiSuC10MM" Background="Transparent">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Vertical" ItemHeight="100" ItemWidth="86"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0,0,0,0">
                            <StackPanel Width="75" Margin="0,0,0,0" Orientation="Vertical">
                                <Label Height="32" Width="70" Margin="0,0,0,0" BorderThickness="0,0,0,0" Tag="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" FontSize="18" BorderBrush="#FF394376" Content="{Binding GradeStart, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Foreground="{DynamicResource FontColorStart}" VerticalAlignment="Bottom" VerticalContentAlignment="Bottom" />
                                <Label Height="32" Width="70" Margin="0,0,0,0" Background="{Binding GradeColor, UpdateSourceTrigger=PropertyChanged }" Tag="{Binding Tag, UpdateSourceTrigger=PropertyChanged,Mode=OneWay}"  Cursor="Hand" MouseDown="ButtonColorSelect_Click" />
                                <TextBox Height="32" Width="70" Margin="0,0,0,0"  BorderThickness="1,1,1,1" FontSize="19" Text="{Binding GradeEnd, UpdateSourceTrigger=PropertyChanged,Mode=OneWay, Converter={StaticResource DecimalConverter}}" Tag="{Binding Tag, UpdateSourceTrigger=PropertyChanged }"  BorderBrush="#FF999396" Foreground="{DynamicResource FontColorStart}" LostFocus="TextBox_LostFocus" PreviewKeyDown="TextBox_PreviewKeyDown"  />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </Grid>
 

        <Grid Grid.Row="3" Margin="0,0,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="10*"/> 
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions> 
                <RowDefinition Height="65"/>
                <RowDefinition Height="65"/>
                <RowDefinition Height="65"/>
            </Grid.RowDefinitions>
             
            
            <Button Style="{StaticResource MaterialDesignFloatingActionMiniAccentButton}"
                Grid.Column="1" Grid.Row="0" Width="16" Height="16" Margin="0,0,20,0"
                ToolTip="出现错误。" Name="ErrorInfo" Visibility="Hidden" >
                <materialDesign:PackIcon Kind="ExclamationThick" Height="10" Width="10" />
            </Button>
            <!--<Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="15" Grid.RowSpan="4" BorderThickness="2,2,2,2" BorderBrush="{DynamicResource BgColorBBoard}">
                <Border  Margin="10,0,0,0" Width="110" HorizontalAlignment="Center" BorderThickness="2,0,2,0" BorderBrush="{DynamicResource BgColorBBoard}">

                </Border>
            </Border>-->

            <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="#FF2C935A" 
                    x:Name="BtnStart" Click="BtnStart_Click" BorderThickness="0"
                    IsEnabled="{Binding CanBtnStart, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="60" Cursor="Hand">
                <TextBlock Text="开始(S)" />
            </Button>

            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1" Background="#FF7938B9" Visibility="Visible"
                    x:Name="BtnFinish" Click="BtnFinish_Click" BorderThickness="0" BorderBrush="#FF7938B9"
                    IsEnabled="{Binding CanBtnFinish, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"  FontSize="15" FontWeight="Bold" 
                    Height="60" Cursor="Hand">
                <TextBlock Text="结束(Q)" />
            </Button>
            
            <Button Grid.Row="1" Grid.Column="1" Background="#3275fd"
                    x:Name="BtnPause" Click="BtnPause_Click" BorderThickness="0"
                    IsEnabled="{Binding CanBtnPause, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="60" Cursor="Hand">
                <TextBlock Text="暂停(P)" />
            </Button>


            <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Background="#FF7938B9"
                    x:Name="BtnShowHistory" BorderThickness="0" Click="BtnShowHistory_Click"
                    IsEnabled="{Binding CanBtnStart, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="60" Cursor="Hand">
                <TextBlock x:Name="BtnShowHistoryTxt" Text="进入选择页面(B)"  />
            </Button>
 
        </Grid>

    </Grid>
</UserControl>
