<UserControl x:Class="MKSS.APP.ECTester.UIZhuiSuC10SensorItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:MKSS.APP.ECTester"
             mc:Ignorable="d" BorderThickness="0"  >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="14*"/>
            <ColumnDefinition Width="6*"/> 
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="20*"/> 
        </Grid.RowDefinitions>
        <Label x:Name="TextPanel" MouseEnter="TextPanel_MouseEnter" MouseLeave="TextPanel_MouseLeave"  MouseMove="TextPanel_MouseMove" 
               VerticalContentAlignment="Center"   Margin="1,1,1,1" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4" Grid.RowSpan="1" 
               BorderThickness="0" Content="-" FontSize="13.6" Background="#323C6B" Cursor="Hand"/>
        <Label x:Name="ColorPanel" MouseEnter="TextPanel_MouseEnter" MouseLeave="TextPanel_MouseLeave" MouseMove="TextPanel_MouseMove" 
               Margin="1,1,1,1" Content="" Grid.Column="0"  Grid.ColumnSpan="4" Grid.Row="0" Grid.RowSpan="1"  
               BorderThickness="0" FontSize="16" Background="#303060" Cursor="Hand"/>
        <Label x:Name="ColorPanelFull" MouseEnter="TextPanel_MouseEnter" MouseLeave="TextPanel_MouseLeave" MouseMove="TextPanel_MouseMove"  Margin="0,0,0,0" Visibility="Hidden" BorderThickness="0"  Content="" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="2"  FontSize="16" Background="#323C6B" Cursor="Hand"/>
        <Label  x:Name="PosotionPanel" Margin="1,1,1,1" Visibility="Hidden" Content="C21" Canvas.Left="-2" Canvas.Bottom="-3" FontSize="11" />
    </Grid>

</UserControl>
