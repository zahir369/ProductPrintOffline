<Window x:Class="MKSS.APP.SemiTester.UIChartWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:MKSS.APP.SemiTester"
        xmlns:d3="clr-namespace:InteractiveDataDisplay.WPF;assembly=InteractiveDataDisplay.WPF"
        mc:Ignorable="d" ShowInTaskbar="False" Background="{DynamicResource MaterialDesignPaper}" Foreground="LightGray"
        Title="历史曲线" Height="430" Width="1400" Loaded="Window_Loaded" Unloaded="Window_Unloaded" Closing="Window_Closing">
    <Window.Resources>
        <local:VisibilityToCheckedConverter x:Key="VisibilityToCheckedConverter"/>
        <ContextMenu x:Key="ContextMenuA">
            <MenuItem Name="btnSelectAll" Header="全　选" Click="btnSelectAll_Click"/>
            <MenuItem Name="btnUnSelectAll" Header="全不选" Click="btnUnSelectAll_Click"/>
            <MenuItem Name="btnRevSelectAll" Header="反　选" Click="btnRevSelectAll_Click"/>
            <Separator></Separator>
            <MenuItem Name="Refresh" Header="刷新" Click="Refresh_Click"/>
        </ContextMenu>
    </Window.Resources>
    <Grid Margin="0 0 0 0" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="79*"/> 
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <d3:Chart Name="plotter" Background="{DynamicResource MaterialDesignPaper}" 
                  Foreground="LightGray" PlotHeight="1050" PlotWidth="880" PlotOriginX="-10" PlotOriginY="-20"  ToolTip="右键全选或反选" ContextMenu="{StaticResource ContextMenuA}"
                  PreviewMouseWheel="plotter_MouseWheel" MouseLeftButtonDown="plotter_MouseLeftButtonDown"
                  IsHorizontalNavigationEnabled="True" IsVerticalNavigationEnabled="True" LegendVisibility="Hidden" Grid.ColumnSpan="2" >
            <d3:Chart.Title>
                <TextBlock x:Name="ChartTitle" FontWeight="Bold" HorizontalAlignment="Center" FontSize="21" Margin="0,5,0,5"></TextBlock>
            </d3:Chart.Title> 
            <Grid Name="lines" />
        </d3:Chart>
        <ItemsControl  Grid.Column="0" Grid.Row="0" Width="280" 
                       Padding="0,40,0,20" HorizontalAlignment="Right"  HorizontalContentAlignment="Right"
              ToolTip="右键全选或反选" ContextMenu="{StaticResource ContextMenuA}"
             x:Name="legengA" Background="Transparent">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="0,2,0,0">
                        <StackPanel Width="70" Margin="0,0,0,0" Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding Path=Checked, Mode=TwoWay}" Cursor="Hand" Tag="{Binding Path=Description}" />
                            <Line Width="15" Height="15" X1="0" Y1="0" X2="15" Y2="15" Stroke="{Binding Path=Stroke}" Cursor="Hand" StrokeThickness="2" Tag="{Binding Path=Description}" />
                            <TextBlock Margin="5,0,0,0" Foreground="LightGray" Text="{Binding Path=Description}"  Cursor="Hand" Tag="{Binding Path=Description}"  />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!--<CheckBox x:Name="SelectX" IsChecked="False" Margin="0 10 310 0" HorizontalAlignment="Right" VerticalAlignment="Top" Checked="SelectX_Checked" Unchecked="SelectX_Checked" Content="选" Grid.Column="1" />
        <CheckBox x:Name="SelectXRev" IsChecked="False" Margin="0 10 270 0" HorizontalAlignment="Right" VerticalAlignment="Top" Checked="SelectXRev_Checked" Unchecked="SelectXRev_Checked" Content="不" Grid.Column="1" />-->
        <CheckBox x:Name="LockX" IsChecked="True" Margin="0 10 110 0" HorizontalAlignment="Right" VerticalAlignment="Top" Checked="LockX_Checked" Unchecked="LockX_Checked" Content="缩放数值" Grid.Column="1" />
        <CheckBox x:Name="LockY" IsChecked="False" Margin="0 10 190 0" HorizontalAlignment="Right" VerticalAlignment="Top" Checked="LockX_Checked" Unchecked="LockX_Checked" Content="缩放时间" Grid.Column="1" />
        <Button  Style="{StaticResource MaterialDesignRaisedButton}"  HorizontalAlignment="Right" VerticalAlignment="Top"  Grid.Column="1" Height="26"
                    materialDesign:ButtonAssist.CornerRadius="2"  BorderThickness="0"  materialDesign:ShadowAssist.ShadowDepth="Depth1" Click="BtnExport_Click"
                     x:Name="BtnExport" Content="导出结果" Background="#FF0029FF"  Margin="0 5 6 0"/>
    </Grid>
</Window>
