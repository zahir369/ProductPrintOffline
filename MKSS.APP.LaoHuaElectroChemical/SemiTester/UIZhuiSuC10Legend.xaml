<UserControl x:Class="MKSS.APP.SemiTester.UIZhuiSuC10Legend"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MKSS.APP.SemiTester" Loaded="UserControl_Loaded"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"  Background="#323C6B" >
    <UserControl.DataContext>
        <local:UIZhuiSuC10SettingModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <local:NullableDecimalConverter x:Key="DecimalConverter"/>
    </UserControl.Resources>
    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/> 
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>

        <Label x:Name="RefreshProgressText" Height="32"  Width="32"  
               HorizontalAlignment="Right" Content="00" FontSize="21"  Grid.Column="0" Grid.Row="0"  
               Margin="3,1,28,0" BorderThickness="0,0,0,0" BorderBrush="#FF394376"  VerticalContentAlignment="Center"
               Foreground="{DynamicResource FontColorStart}" />
        <Label x:Name="FullQueryTimesText" Height="32"   
               HorizontalAlignment="Left" Content="0000000" FontSize="21"  Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2"  
               Margin="-10,1,28,0" BorderThickness="0,0,0,0" BorderBrush="#FF394376"  VerticalContentAlignment="Center"
               Foreground="{DynamicResource FontColorStart}" />
        <ProgressBar HorizontalAlignment="Right" Value="100" Margin="0,-23,20,0"
              x:Name="RefreshProgress" Grid.Column="0" Grid.Row="0" Width="45"
              Style="{StaticResource MaterialDesignCircularProgressBar}" />
        <ComboBox   Grid.Row="0" Grid.Column="4" 
                    PreviewMouseUp="TxtSerialPorts_PreviewMouseUp"
                    x:Name="TxtSerialPorts" Margin="-20,10,10,10"
                    Style="{StaticResource MaterialDesignFilledComboBox}" Visibility="Visible"
                    IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}" >
            <materialDesign:HintAssist.Hint>
                <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                    <materialDesign:PackIcon Kind="SerialPort" />
                    <TextBlock x:Name="TxtSerialPortsDesc"  Text="串口"  FontSize="14" FontWeight="Bold" />
                </StackPanel>
            </materialDesign:HintAssist.Hint>
            <ComboBoxItem Content="COM1" />
            <ComboBoxItem Content="COM2" />
            <ComboBoxItem Content="COM3" />
        </ComboBox>

        <TextBox  Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="1"
                    x:Name="TxtCurrentSpanValue"  
                    Margin="10,10,10,10" PreviewKeyDown="Txt_InputNumber"
                    Text="20.9"
                    IsEnabled="{Binding CanBtnStart, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:TextFieldAssist.HasClearButton="True" 
                    materialDesign:TextFieldAssist.PrefixText="" 
                    materialDesign:TextFieldAssist.SuffixText="" >
            <materialDesign:HintAssist.Hint>
                <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                    <TextBlock Text="标定浓度" FontSize="14" FontWeight="Bold" />
                </StackPanel>
            </materialDesign:HintAssist.Hint>
        </TextBox>
        
        <Button Style="{StaticResource MaterialDesignFloatingActionMiniAccentButton}"
                Grid.Column="2" Grid.Row="0" Width="16" Height="16" Margin="0,0,20,0"
                ToolTip="出现错误。" Name="ErrorInfo" Visibility="Hidden" >
            <materialDesign:PackIcon Kind="ExclamationThick" Height="10" Width="10" />
        </Button>
        <!--<Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="15" Grid.RowSpan="4" BorderThickness="2,2,2,2" BorderBrush="{DynamicResource BgColorBBoard}">
            <Border  Margin="10,0,0,0" Width="110" HorizontalAlignment="Center" BorderThickness="2,0,2,0" BorderBrush="{DynamicResource BgColorBBoard}">

            </Border>
        </Border>-->

        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="13*"/> 
                <ColumnDefinition Width="70*"/> 
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20*"/> 
            </Grid.RowDefinitions>
            <ListBox Grid.Column="0" Padding="5,0,0,0" SelectionChanged="RadioButtonGroupChoiceChipAccent_SelectionChanged"
                Style="{StaticResource MaterialDesignChoiceChipAccentListBox}" x:Name="RadioButtonGroupChoiceChipAccent">
                <ListBoxItem IsSelected="True" Content="电压" />
                <ListBoxItem Content="浓度" /> 
            </ListBox>
            <ItemsControl  Grid.Column="2" Grid.Row="0"  Grid.ColumnSpan="16" Grid.RowSpan="3" Margin="1,3,1,6"  HorizontalAlignment="Center" 
             x:Name="UIZhuiSuC10MM" Background="Transparent">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Vertical" ItemHeight="96" ItemWidth="61"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0,0,0,0">
                            <StackPanel Width="57" Margin="0,-9,0,0" Orientation="Vertical">
                                <Label  Height="32"  Width="55" Tag="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" FontSize="18"  Margin="3,1,0,0" BorderThickness="0,0,0,0" BorderBrush="#FF394376" Content="{Binding GradeStart, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Foreground="{DynamicResource FontColorStart}" VerticalAlignment="Bottom" VerticalContentAlignment="Bottom" />
                                <Label Height="21"   Width="46" Background="{Binding GradeColor, UpdateSourceTrigger=PropertyChanged }" Tag="{Binding Tag, UpdateSourceTrigger=PropertyChanged,Mode=OneWay}" Margin="1,5,1,0" Cursor="Hand" MouseDown="ButtonColorSelect_Click" />
                                <TextBox Height="32"  Width="53" FontSize="19" Text="{Binding GradeEnd, UpdateSourceTrigger=PropertyChanged,Mode=OneWay, Converter={StaticResource DecimalConverter}}" Tag="{Binding Tag, UpdateSourceTrigger=PropertyChanged }" Margin="0,1,3,0"  BorderThickness="1,1,1,1" BorderBrush="#FF999396" Foreground="{DynamicResource FontColorStart}" LostFocus="TextBox_LostFocus" PreviewKeyDown="TextBox_PreviewKeyDown"  />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>


        <Button Grid.Row="2" Grid.Column="0" Background="#3275fd"
                    x:Name="BtnStart" Click="BtnStart_Click" BorderThickness="0"
                    IsEnabled="{Binding CanBtnStart, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32" Cursor="Hand">
            <TextBlock Text="开始(S)" />
        </Button>

        <Button Grid.Row="2" Grid.Column="1" Background="#3275fd"
                    x:Name="BtnPause" Click="BtnPause_Click" BorderThickness="0" 
                    IsEnabled="{Binding CanBtnPause, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32" Cursor="Hand">
            <TextBlock Text="暂停(P)" />
        </Button>

        <Button Grid.Row="2" Grid.Column="2" Background="#FF7938B9"
                    x:Name="BtnFinish" Click="BtnFinish_Click" BorderThickness="0" BorderBrush="#FF7938B9"
                    IsEnabled="{Binding CanBtnFinish, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"  FontSize="15" FontWeight="Bold" 
                    Height="32" Cursor="Hand">
            <TextBlock Text="结束(Q)" />
        </Button>

        <Button Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Background="#FF2C935A"
                    x:Name="BtnSetSpan" BorderThickness="0" Click="BtnSetSpan_Click"
                    IsEnabled="{Binding CanBtnStart, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32" Cursor="Hand">
            <TextBlock Text="标定浓度(B)" />
        </Button>
        
        <Button  Grid.Row="0" Grid.Column="4"  Background="#FF112B61" BorderThickness="0"
                    x:Name="BtnExcelExport" Click="BtnExcelExport_Click" 
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32" Visibility="Hidden"   
                    ToolTip="" Cursor="Hand">
            <TextBlock Text="导出(E)" />
        </Button>

        
        <!--<Button Grid.Row="0" Grid.Column="4" Background="#FF741348" BorderThickness="0"
                    x:Name="BtnExit" Click="BtnExit_Click"  Visibility="Visible" 
                    Style="{StaticResource MaterialDesignRaisedDarkButton}" 
                    materialDesign:ButtonAssist.CornerRadius="6"   FontSize="15" FontWeight="Bold" 
                    Height="32" Cursor="Hand">
            <TextBlock Text="退出系统(U)" />
        </Button>-->


    </Grid>
</UserControl>
